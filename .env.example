# Node.js Server
PORT=3000
SESSION_SECRET=your_secure_random_session_secret
ADMIN_INITIAL_PASSWORD=your_secure_admin_password

# Database
# DB_PATH is optional, defaults to ./neobyte.db
DB_PATH=./neobyte.db

# Blockchain RPC Endpoints
# Provide valid endpoints (and credentials if required) for each supported currency.
# If an endpoint is missing, that currency's payment detection will fail.

# Bitcoin (BTC)
BTC_RPC=http://rpcuser:rpcpassword@127.0.0.1:8332

# Litecoin (LTC)
LTC_RPC=http://rpcuser:rpcpassword@127.0.0.1:9332

# Bitcoin Cash (BCH)
BCH_RPC=http://rpcuser:rpcpassword@127.0.0.1:8332

# Ethereum (ETH)
ETH_RPC=http://127.0.0.1:8545

# Monero (XMR) - Uses monero-wallet-rpc
XMR_RPC=http://rpcuser:rpcpassword@127.0.0.1:18082

# ---- TREASURY SYSTEM ----
# Wallet passphrases for UTXO chain nodes (used to unlock wallets for signing)
# Leave blank if wallet is not encrypted
BTC_WALLET_PASSPHRASE=
LTC_WALLET_PASSPHRASE=
BCH_WALLET_PASSPHRASE=

# Ethereum signing key (hex private key, WITHOUT 0x prefix)
# SECURITY: Never commit this value. Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ETH_SIGNING_KEY=

# Treasury Configuration
TREASURY_STEP_UP_TIMEOUT=300
TREASURY_MAX_WITHDRAWAL_BTC=10
TREASURY_MAX_WITHDRAWAL_LTC=1000
TREASURY_MAX_WITHDRAWAL_ETH=100
TREASURY_MAX_WITHDRAWAL_BCH=100
TREASURY_MAX_WITHDRAWAL_XMR=500
