<%- include('header') %>

<div class="container">
    <h2 style="color: #111; margin-bottom: 20px;">Admin Panel</h2>
    
    <!-- ASSET UPLOADER -->
    <div class="form-panel" style="margin-bottom: 40px; border-top: 4px solid #3b82f6;">
        <h3 style="margin-bottom: 20px;">Site Assets & Banners</h3>
        <p style="font-size: 13px; color: #666; margin-bottom: 20px;">Upload image files to update the site's branding. Files will overwrite the existing placeholders.</p>
        <form action="/admin/upload-asset" method="POST" enctype="multipart/form-data">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 15px;">
                <div class="form-group">
                    <label>Main Logo (logo.png)</label>
                    <input type="file" name="logo.png" class="form-control" accept="image/png, image/jpeg">
                </div>
                <div class="form-group">
                    <label>Default Vendor Logo (default-vendor-logo.png)</label>
                    <input type="file" name="default-vendor-logo.png" class="form-control" accept="image/png, image/jpeg">
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 15px;">
                <div class="form-group">
                    <label>Top Banner 1 (top-banner-1.jpg)</label>
                    <input type="file" name="top-banner-1.jpg" class="form-control" accept="image/png, image/jpeg">
                </div>
                <div class="form-group">
                    <label>Top Banner 2 (top-banner-2.jpg)</label>
                    <input type="file" name="top-banner-2.jpg" class="form-control" accept="image/png, image/jpeg">
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 15px;">
                <div class="form-group">
                    <label>Bottom Banner 1 (bottom-banner-1.jpg)</label>
                    <input type="file" name="bottom-banner-1.jpg" class="form-control" accept="image/png, image/jpeg">
                </div>
                <div class="form-group">
                    <label>Bottom Banner 2 (bottom-banner-2.jpg)</label>
                    <input type="file" name="bottom-banner-2.jpg" class="form-control" accept="image/png, image/jpeg">
                </div>
            </div>
            <button type="submit" class="btn" style="background: #3b82f6; color: white; border: none; padding: 10px 20px; font-weight: bold; border-radius: 2px; cursor: pointer;">Upload Selected Assets</button>
        </form>
    </div>

    <!-- VENDOR MANAGEMENT -->
    <div style="display: flex; gap: 20px; margin-bottom: 40px;">
        <!-- CREATE VENDOR -->
        <div class="form-panel" style="flex: 1; border-top: 4px solid #10b981; margin: 0;">
            <h3 style="margin-bottom: 20px;">Create Vendor Account</h3>
            <form action="/admin/vendors/create" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <label>Login Username</label>
                    <input type="text" name="username" class="form-control" placeholder="e.g. hackerman99" required>
                </div>
                <div class="form-group">
                    <label>Login Password</label>
                    <input type="password" name="password" class="form-control" placeholder="Strong password" required>
                </div>
                <div class="form-group">
                    <label>Vendor Store Name</label>
                    <input type="text" name="vendor_name" class="form-control" placeholder="e.g. Hackerman's Digital Goods" required>
                </div>
                <div class="form-group">
                    <label>Store Description</label>
                    <textarea name="vendor_description" class="form-control" rows="2" placeholder="Describe the vendor's offerings..." required></textarea>
                </div>
                <button type="submit" class="btn" style="background: #10b981; color: white; border: none; padding: 10px 20px; font-weight: bold; border-radius: 2px; cursor: pointer; width: 100%;">Create & Approve Vendor</button>
            </form>
        </div>

        <!-- MANAGE VENDORS -->
        <div class="form-panel" style="flex: 2; border-top: 4px solid #10b981; margin: 0;">
            <h3 style="margin-bottom: 20px;">Manage Approved Vendors (<%= typeof vendors !== 'undefined' ? vendors.length : 0 %>)</h3>
            <% if (typeof vendors !== 'undefined' && vendors.length > 0) { %>
                <table style="width: 100%; border-collapse: collapse; font-size: 14px;">
                    <thead>
                        <tr style="border-bottom: 2px solid #eee; text-align: left;">
                            <th style="padding: 10px;">ID</th>
                            <th style="padding: 10px;">Username</th>
                            <th style="padding: 10px;">Store Name</th>
                            <th style="padding: 10px; text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% vendors.forEach(v => { %>
                            <tr style="border-bottom: 1px solid #eee;">
                                <td style="padding: 10px;">#<%= v.id %></td>
                                <td style="padding: 10px;"><strong><%= v.username %></strong></td>
                                <td style="padding: 10px; color: #555;"><%= v.vendor_name %></td>
                                <td style="padding: 10px; text-align: right;">
                                    <form action="/admin/vendors/impersonate/<%= v.id %>" method="POST" style="display:inline;">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <button type="submit" class="btn" style="background: #ef4444; color: white; border: none; padding: 6px 12px; font-weight: bold; border-radius: 2px; cursor: pointer; font-size: 12px;">Login as Vendor (God Mode)</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } else { %>
                <p style="color: #666; text-align: center; margin-top: 40px;">No vendors found.</p>
            <% } %>
        </div>
    </div>

    <div class="form-panel" style="margin-bottom: 40px; border-top: 4px solid var(--primary-purple);">
        <h3 style="margin-bottom: 20px;">Add New Product (Card) - Global/Admin Store</h3>
        <form action="/admin/products/add" method="POST" enctype="multipart/form-data">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="form-group">
                    <label>Product Name</label>
                    <input type="text" name="name" class="form-control" placeholder="e.g. VISA Platinum $5000" required>
                </div>
                <div class="form-group">
                    <label>Price (USD)</label>
                    <input type="number" step="0.01" name="price" class="form-control" placeholder="e.g. 150.00" required>
                </div>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                <div class="form-group">
                    <label>Limit Amount (optional)</label>
                    <input type="number" name="limit_amount" class="form-control" placeholder="e.g. 5000">
                </div>
                <div class="form-group">
                    <label>Tier</label>
                    <select name="tier" class="form-control">
                        <option value="standard">Standard</option>
                        <option value="premium">Premium</option>
                        <option value="exclusive">Exclusive</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>Description</label>
                <textarea name="description" class="form-control" rows="3" placeholder="Describe the card features..." required></textarea>
            </div>

            <div class="form-group">
                <label>Product Image (PNG/JPG)</label>
                <input type="file" name="product_image" class="form-control" accept="image/*" required>
            </div>

            <button type="submit" class="btn btn-purple" style="margin-top: 10px;">Create Product</button>
        </form>
    </div>

    <h3 style="margin-bottom: 20px;">Recent Orders</h3>

    <% if (orders.length === 0) { %>
        <div class="form-panel" style="text-align: center;">
            <p>No orders in the system.</p>
        </div>
    <% } else { %>
        <div style="display: flex; flex-direction: column; gap: 20px;">
            <% orders.forEach(order => { %>
                <div class="form-panel" style="border-left: 4px solid <%= order.status === 'active' ? 'var(--primary-green)' : '#f59e0b' %>;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 15px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">
                        <div>
                            <strong style="font-size: 16px;">Order #<%= order.id %></strong> - <%= order.product_name %><br>
                            <span style="font-size: 12px; color: var(--text-muted);">Customer: <%= order.customer_name %> | <%= new Date(order.created_at).toLocaleString() %></span>
                        </div>
                        <span style="background: <%= order.status === 'active' ? 'var(--primary-green)' : '#f59e0b' %>; color: white; padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; text-transform: uppercase; height: max-content;">
                            <%= order.status %>
                        </span>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        <div>
                            <h4 style="margin-bottom: 10px; font-size: 14px;">Payment Proof</h4>
                            <% if (order.payment_proof) { %>
                                <a href="<%= order.payment_proof %>" target="_blank">
                                    <img src="<%= order.payment_proof %>" alt="Proof" style="width: 100%; max-height: 200px; object-fit: contain; border: 1px solid var(--border-color); border-radius: 4px;">
                                </a>
                            <% } else { %>
                                <p style="font-size: 12px; color: var(--text-muted);">No proof uploaded.</p>
                            <% } %>
                        </div>

                        <div>
                            <% if (order.status === 'pending') { %>
                                <h4 style="margin-bottom: 10px; font-size: 14px;">Deliver Product</h4>
                                <form action="/admin/verify/<%= order.id %>" method="POST">
                                    <div class="form-group">
                                        <input type="text" name="card_number" class="form-control" placeholder="Card Number (XXXX XXXX XXXX XXXX)" required>
                                    </div>
                                    <div style="display: flex; gap: 10px;">
                                        <div class="form-group" style="flex: 1;">
                                            <input type="text" name="expiry" class="form-control" placeholder="Exp (MM/YY)" required>
                                        </div>
                                        <div class="form-group" style="flex: 1;">
                                            <input type="text" name="cvv" class="form-control" placeholder="CVV" required>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-green btn-block">Mark Completed</button>
                                </form>
                            <% } else { %>
                                <h4 style="margin-bottom: 10px; font-size: 14px;">Delivered Data</h4>
                                <div style="background: #f8fafc; padding: 15px; border: 1px solid var(--border-color); border-radius: 4px; font-family: monospace; font-size: 14px;">
                                    <%= order.card_number %><br>
                                    <%= order.expiry %> | <%= order.cvv %>
                                </div>
                            <% } %>
                            
                            <form action="/admin/delete/<%= order.id %>" method="POST" style="margin-top: 20px; text-align: right;" onsubmit="return confirm('Delete this order completely?');">
                                <button type="submit" style="background: transparent; border: none; color: #ef4444; font-size: 12px; cursor: pointer; text-decoration: underline;">Delete Order</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>

    <h3 style="margin-top: 40px; margin-bottom: 20px;">User Support Messages</h3>
    <% if (typeof messages !== 'undefined' && messages && messages.length > 0) { %>
        <div style="display: flex; flex-direction: column; gap: 15px;">
            <% messages.forEach(msg => { %>
                <div class="form-panel" style="border-left: 4px solid var(--primary-purple);">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 10px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px;">
                        <strong style="font-size: 16px;"><%= msg.subject %></strong>
                        <span style="font-size: 12px; color: var(--text-muted);">From: <%= msg.sender_name %> | <%= new Date(msg.created_at).toLocaleString() %></span>
                    </div>
                    <div style="font-family: monospace; white-space: pre-wrap; font-size: 13px; background: #f8fafc; padding: 15px; border-radius: 4px; margin-bottom: 15px;"><%= msg.body %></div>
                    
                    <div style="display: flex; gap: 10px;">
                        <form action="/admin/message/reply/<%= msg.sender_id %>" method="POST" style="flex: 1;">
                            <textarea name="body" class="form-control" rows="3" placeholder="Write reply here..." required></textarea>
                            <button type="submit" class="btn btn-purple" style="margin-top: 10px; font-size: 12px; padding: 5px 15px;">Send Reply</button>
                        </form>
                        
                        <% if (msg.is_vendor === 0 && msg.subject.includes('[Partnership Department]')) { %>
                            <form action="/admin/approve-vendor/<%= msg.sender_id %>" method="POST" style="align-self: flex-end;">
                                <button type="submit" class="btn" style="background: #28a745; color: white; margin-top: 10px; font-size: 12px; padding: 5px 15px; font-weight: bold; border-radius: 4px;">Approve Vendor Status</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="form-panel" style="text-align: center;">
            <p>No new messages from users.</p>
        </div>
    <% } %>
</div>

<%- include('footer') %>
