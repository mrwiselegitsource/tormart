<%- include('header') %>
<div class="admin-container" style="max-width: 1000px; margin: 0 auto; padding: 40px 20px;">
    <h2 style="margin-bottom: 10px;">Map Reviews to Products</h2>
    <p style="color: #64748b; margin-bottom: 30px;">Select the target product for each imported review from the dropdowns below.</p>
    
    <form action="/admin/reviews/bulk-import-finalize" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="vendor_id" value="<%= vendor_id %>">
        
        <div style="display: flex; flex-direction: column; gap: 20px; margin-bottom: 30px;">
            <% reviews.forEach((review, index) => { %>
                <div style="background: white; padding: 20px; border-radius: 8px; border: 1px solid #e2e8f0; display: flex; gap: 20px; align-items: flex-start;">
                    <div style="flex: 1;">
                        <strong><%= review.username || "Anonymous" %></strong> 
                        <span style="background: #e2e8f0; padding: 2px 6px; border-radius: 4px; font-size: 12px; margin-left: 10px;"><%= review.badge || "Buyer" %></span>
                        <div style="margin-top: 10px; color: #475569; font-size: 14px;"><%= review.comment %></div>
                        <div style="margin-top: 10px; color: #94a3b8; font-size: 12px;">Rating: <%= review.rating || 5 %> | Date: <%= review.date || "Now" %></div>
                        
                        <!-- Hidden fields to pass the data along -->
                        <input type="hidden" name="usernames[]" value="<%= review.username || 'Anonymous' %>">
                        <input type="hidden" name="badges[]" value="<%= review.badge || 'Buyer' %>">
                        <input type="hidden" name="ratings[]" value="<%= review.rating || 5 %>">
                        <input type="hidden" name="comments[]" value="<%= review.comment || '' %>">
                        <input type="hidden" name="dates[]" value="<%= review.date || '' %>">
                    </div>
                    
                    <div style="width: 350px;">
                        <label style="font-weight: bold; font-size: 14px; display: block; margin-bottom: 8px;">Assign to Product:</label>
                        <select name="product_ids[]" style="width: 100%; padding: 10px; border-radius: 4px; border: 1px solid #ccc; background: #f8fafc;">
                            <option value="">-- General Vendor Review (No Product) --</option>
                            <% products.forEach(product => { %>
                                <option value="<%= product.id %>" <%= review.product_id == product.id ? 'selected' : '' %>><%= product.name %> (ID: #<%= product.id %>)</option>
                            <% }) %>
                        </select>
                    </div>
                </div>
            <% }) %>
        </div>
        
        <div style="display: flex; gap: 20px; align-items: center; border-top: 1px solid #e2e8f0; padding-top: 30px;">
            <button type="submit" class="btn" style="background: #10b981; color: white; border: none; padding: 12px 30px; font-weight: bold; border-radius: 4px; cursor: pointer; font-size: 16px;">Finalize Import (<%= reviews.length %> Reviews)</button>
            <a href="/admin" style="color: #64748b; text-decoration: none; font-weight: bold;">Cancel</a>
        </div>
    </form>
</div>
<%- include('footer') %>
