<%- include('header') %>

<div class="container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <h2 style="color: #111;">My Profile</h2>
    </div>

    <% if (orders.length === 0) { %>
        <div class="form-panel" style="text-align: center;">
            <p>You have no orders history.</p>
        </div>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Product</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                    <tr>
                        <td style="font-weight: bold;">#<%= order.id %></td>
                        <td><%= order.name %></td>
                        <td style="color: var(--text-muted); font-size: 12px;"><%= new Date(order.created_at).toLocaleString() %></td>
                        <td>
                            <span style="background: <%= (order.status === 'completed' || order.status === 'paid_out') ? 'var(--primary-green)' : (order.status === 'disputed' || order.status === 'refunded' ? 'red' : '#f59e0b') %>; color: white; padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: bold; text-transform: uppercase;">
                                <%= order.status %>
                            </span>
                        </td>
                        <td>
                            <% if (order.status === 'shipped' || order.status === 'completed' || order.status === 'paid_out') { %>
                                <div style="background: #f8fafc; padding: 10px; border: 1px solid var(--border-color); border-radius: 4px; font-family: monospace; font-size: 12px; margin-top: 5px; word-break: break-all;">
                                    <strong>Delivery Data / Digital Key:</strong><br>
                                    <%= order.download_key || order.delivery_note || 'No data provided' %>
                                </div>
                            <% } %>

                            <% if (order.status === 'shipped') { %>
                                <div style="margin-top: 10px;">
                                    <form action="/order/complete/<%= order.id %>" method="POST" enctype="multipart/form-data" style="display: flex; gap: 5px; flex-direction: column;">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <select name="rating" required style="padding: 5px;">
                                            <option value="5">★★★★★ (5/5)</option>
                                            <option value="4">★★★★☆ (4/5)</option>
                                            <option value="3">★★★☆☆ (3/5)</option>
                                            <option value="2">★★☆☆☆ (2/5)</option>
                                            <option value="1">★☆☆☆☆ (1/5)</option>
                                        </select>
                                        <input type="text" name="comment" placeholder="Leave a review..." required style="padding: 5px;">
                                        <div style="font-size: 11px; color: #555;">Optional: Upload proof photo or video</div>
                                        <input type="file" name="review_photo" accept="image/*,video/*" style="padding: 5px; font-size: 11px;">
                                        <button type="submit" class="btn" style="background: #28a745; color: white; border: none; padding: 5px; font-weight: bold; cursor: pointer;">Finalize & Release Escrow</button>
                                    </form>
                                </div>
                            <% } else if (order.status === 'completed' || order.status === 'paid_out') { %>
                                <span style="font-size: 12px; color: #28a745; font-weight: bold; display: block; margin-top: 10px;">Escrow Released (Complete)</span>
                            <% } else if (order.status === 'pending') { %>
                                <span style="font-size: 12px; color: var(--text-muted); display: block; margin-top: 10px;">Awaiting Seller Fulfillment</span>
                            <% } else if (order.status === 'disputed') { %>
                                <span style="font-size: 12px; color: red; font-weight: bold; display: block; margin-top: 10px;">In Dispute Resolution</span>
                            <% } else if (order.status === 'refunded') { %>
                                <span style="font-size: 12px; color: red; font-weight: bold; display: block; margin-top: 10px;">Refunded</span>
                            <% } %>

                            <% if (order.status === 'pending' || order.status === 'shipped') { %>
                                <form action="/order/dispute/<%= order.id %>" method="POST" style="margin-top: 5px;" onsubmit="confirmDispute(event, this)">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button type="submit" style="background: none; border: none; color: red; text-decoration: underline; cursor: pointer; font-size: 11px; padding: 0;">Dispute Order</button>
                                </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>

<!-- Custom Dispute Modal -->
<style>
    .custom-modal-overlay {
        display: none;
        position: fixed;
        top: 0; left: 0; width: 100%; height: 100%;
        background: rgba(0, 0, 0, 0.6);
        z-index: 1000;
        justify-content: center;
        align-items: center;
    }
    .custom-modal-content {
        background: #fff;
        padding: 25px;
        border-radius: 8px;
        width: 320px;
        color: #333;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }
    .custom-modal-content h3 {
        margin-top: 0; 
        margin-bottom: 15px;
        font-size: 18px;
    }
    .custom-modal-content p {
        margin-bottom: 25px;
        font-size: 14px;
        color: #555;
        line-height: 1.5;
    }
    .modal-btn-container {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }
    .btn-modal {
        padding: 8px 16px;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-weight: bold;
        transition: background 0.2s;
    }
    .btn-cancel {
        background: #e2e8f0;
        color: #334155;
    }
    .btn-cancel:hover { background: #cbd5e1; }
    .btn-confirm {
        background: #0056b3; /* Darker blue to match typical modern confirm buttons */
        color: white;
    }
    .btn-confirm:hover { background: #004494; }
</style>

<div id="disputeModal" class="custom-modal-overlay">
    <div class="custom-modal-content">
        <h3>Confirm Action</h3>
        <p>Are you sure you want to open a dispute? Admin will step in.</p>
        <div class="modal-btn-container">
            <button class="btn-modal btn-cancel" onclick="closeDisputeModal()">Cancel</button>
            <button class="btn-modal btn-confirm" onclick="submitDispute()">OK</button>
        </div>
    </div>
</div>

<script>
    let disputeFormToSubmit = null;
    
    function confirmDispute(event, form) {
        event.preventDefault();
        disputeFormToSubmit = form;
        document.getElementById('disputeModal').style.display = 'flex';
    }
    
    function closeDisputeModal() {
        document.getElementById('disputeModal').style.display = 'none';
        disputeFormToSubmit = null;
    }
    
    function submitDispute() {
        if (disputeFormToSubmit) {
            disputeFormToSubmit.submit();
        }
    }
</script>

<%- include('footer') %>
