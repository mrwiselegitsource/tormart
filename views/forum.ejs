];

let toastIndex = Math.floor(Math.random() * simData.length);

function showToast() {
    const d = simData[toastIndex % simData.length];
    toastIndex++;
    const feed = document.getElementById('sim-feed');
    if (!feed) return;

    const toast = document.createElement('div');
    toast.className = 'sim-toast';
    toast.innerHTML = `
        <div class="toast-avatar">${d.initials}</div>
        <div class="toast-content">
            <div class="toast-name">${d.name} just posted</div>
            <div class="toast-msg">${d.msg.substring(0, 50)}${d.msg.length > 50 ? '...' : ''}</div>
            <div class="toast-time">just now</div>
        </div>
    `;
    feed.appendChild(toast);

    // Auto-remove after 5s
    setTimeout(() => {
        toast.style.animation = 'toastOut 0.4s ease forwards';
        setTimeout(() => toast.remove(), 400);
    }, 5000);

    // Keep max 3 toasts
    while (feed.children.length > 3) {
        feed.removeChild(feed.firstChild);
    }
}

// Start toasts with truly random intervals
function scheduleNextToast() {
    const delay = 3000 + Math.random() * 9000; // Between 3 and 12 seconds
    setTimeout(() => {
        showToast();
        scheduleNextToast();
    }, delay);
}

setTimeout(() => {
    showToast();
    scheduleNextToast();
}, 2000);

// ---- Vote handler (VIP only) ----
<% if (vip) { %>
function vote(e, postId, btn) {
    e.preventDefault(); e.stopPropagation();
    fetch('/forum/post/' + postId + '/vote', {
        method: 'POST',
        headers: { 'x-csrf-token': '<%= csrfToken %>', 'Content-Type': 'application/json' }
    })
    .then(r => r.json())
    .then(d => {
        const countEl = document.getElementById('votes-' + postId);
        if (!countEl) return;
        let current = parseInt(countEl.textContent.replace('k','')) || 0;
        if (d.voted) { countEl.textContent = current + 1; btn.style.color = 'var(--reddit-upvote)'; }
        else { countEl.textContent = Math.max(0, current - 1); btn.style.color = ''; }
    });
}
<% } else { %>
function vote() {}
<% } %>

// Close modal on backdrop click
document.addEventListener('click', (e) => {
    const modal = document.getElementById('newPostModal');
    if (modal && e.target === modal) modal.classList.remove('open');
});
