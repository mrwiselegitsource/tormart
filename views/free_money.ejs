<%- include('header') %>

<style>
    .free-money-container {
        background-color: #eee;
        padding: 40px 20px;
        min-height: calc(100vh - 300px);
    }
    
    .promo-card {
        max-width: 1100px;
        margin: 0 auto 30px auto;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        position: relative;
        color: white;
        text-align: left;
    }
    
    /* Card 1: $10 Free */
    .card-1 {
        background: url('/images/promo_bg_1.jpg') center/cover no-repeat;
        min-height: 280px;
        display: flex;
        align-items: center;
        padding: 40px;
    }
    .card-1-content {
        max-width: 400px;
        background: rgba(0,0,0,0.4);
        padding: 20px;
        border-radius: 8px;
        backdrop-filter: blur(2px);
    }
    .card-1 h2 {
        font-size: 36px;
        font-style: italic;
        margin-bottom: 15px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.8);
    }
    .card-1 p {
        font-size: 14px;
        margin-bottom: 5px;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.8);
    }
    .card-1 .btn-register {
        background: #10b981;
        color: white;
        padding: 10px 25px;
        border-radius: 4px;
        border: none;
        font-weight: bold;
        margin-top: 15px;
        display: inline-block;
        text-decoration: none;
    }

    /* Card 2: Jackpot */
    .card-2 {
        background: linear-gradient(to bottom, rgba(0,0,0,0.1), rgba(0,0,0,0.9)), url('/images/promo_bg_2.jpg') center/cover no-repeat;
        min-height: 500px;
        padding: 40px;
        text-align: center;
        position: relative;
    }
    .ribbon {
        background: linear-gradient(90deg, #f59e0b, #fbbf24);
        color: #000;
        display: inline-block;
        padding: 8px 40px;
        font-weight: bold;
        font-style: italic;
        font-size: 14px;
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        white-space: nowrap;
        max-width: 100%;
    }
    .ribbon::before, .ribbon::after {
        content: "";
        position: absolute;
        top: 0;
        border-top: 17px solid transparent;
        border-bottom: 17px solid transparent;
    }
    .ribbon::before {
        left: -15px;
        border-right: 15px solid #f59e0b;
    }
    .ribbon::after {
        right: -15px;
        border-left: 15px solid #fbbf24;
    }
    .jackpot-title {
        margin-top: 50px;
    }
    .jackpot-title h4 { font-size: 14px; letter-spacing: 2px; color: #ccc; margin-bottom: 5px; }
    .jackpot-title h2 { font-size: 32px; font-style: italic; margin-bottom: 0; }
    .jackpot-title h1 { 
        font-size: 72px; 
        color: #fbbf24; 
        font-style: italic; 
        text-shadow: 0 0 20px rgba(251, 191, 36, 0.4);
        margin: 0;
        line-height: 1;
    }
    .jackpot-title p { font-size: 14px; letter-spacing: 2px; color: #ccc; margin-top: 5px; }
    
    .prize-grid {
        position: absolute;
        top: 140px;
        width: 100%;
        left: 0;
        pointer-events: none;
    }
    .prize-box {
        background: white;
        color: #111;
        border-radius: 8px;
        padding: 10px 20px;
        display: inline-block;
        position: absolute;
        box-shadow: 0 10px 20px rgba(0,0,0,0.3);
        text-align: center;
    }
    .prize-box h3 { font-size: 18px; margin: 0; font-weight: 900; }
    .prize-box p { font-size: 11px; color: #666; margin: 0; }
    .prize-badge {
        background: #fbbf24;
        color: #000;
        border-radius: 4px;
        padding: 2px 8px;
        font-weight: bold;
        font-size: 12px;
        position: absolute;
        top: -10px;
        right: -10px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }
    
    /* Layout of prizes using absolute positioning relative to container */
    .p-1 { left: 10%; top: 0px; }
    .p-2 { left: 20%; top: 80px; }
    .p-3 { left: 10%; top: 160px; }
    .p-4 { right: 10%; top: 0px; }
    .p-5 { right: 20%; top: 80px; }
    .p-6 { right: 10%; top: 160px; }
    
    .jackpot-footer {
        position: absolute;
        bottom: 20px;
        left: 40px;
        right: 40px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }
    .ticket-info {
        max-width: 300px;
        text-align: left;
    }
    .ticket-info p { font-size: 11px; color: #aaa; margin-bottom: 15px; line-height: 1.4; }
    .btn-claim { background: white; color: #111; padding: 8px 20px; border-radius: 4px; border: none; font-weight: bold; margin-right: 10px; cursor: pointer; }
    .btn-winners { background: rgba(255,255,255,0.2); color: white; padding: 8px 20px; border-radius: 4px; border: none; cursor: pointer; }
    
    .calendar-ticks {
        display: flex;
        gap: 5px;
    }
    .tick {
        width: 24px;
        height: 24px;
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        color: rgba(255,255,255,0.5);
    }
    
    .countdown {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
    }
    .time-blocks {
        display: flex;
        gap: 4px;
    }
    .time-block {
        background: rgba(255,255,255,0.15);
        padding: 4px 8px;
        border-radius: 4px;
        font-family: monospace;
        font-weight: bold;
    }
    .time-sep { margin: 0 -2px; }

    .jackpot-disclaimer {
        margin-top: 150px;
        font-size: 11px;
        color: #888;
        max-width: 500px;
        margin-left: auto;
        margin-right: auto;
    }

    /* Card 3: New Promo */
    .card-3 {
        background: linear-gradient(to right, rgba(0,0,0,0.8), rgba(0,0,0,0.4)), url('/images/promo_bg_3.jpg') center/cover no-repeat;
        min-height: 120px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 40px;
    }
    .card-3 h2 { font-size: 20px; margin: 0; }
    .card-3 h3 { font-size: 24px; margin: 0; font-style: italic; }
    .card-3-center { text-align: center; }
    .card-3-center h4 { margin: 0; font-size: 14px; font-style: italic; letter-spacing: 1px; color: #ccc;}
    .card-3-center h1 { margin: 0; font-size: 42px; font-style: italic; line-height: 1; text-shadow: 2px 2px 4px rgba(0,0,0,0.5); }
    .card-3-right { text-align: right; }
    
    /* Card 4: Journey */
    .card-4 {
        background: #ff4d94;
        min-height: 200px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 40px;
    }
    .card-4-content { max-width: 500px; }
    .card-4 h2 { font-size: 28px; margin-bottom: 15px; }
    .card-4 p { font-size: 14px; margin-bottom: 25px; line-height: 1.5; }
    .btn-outline {
        background: transparent;
        border: 1px solid white;
        color: white;
        padding: 8px 25px;
        border-radius: 4px;
        text-decoration: none;
    }
    .card-4-image {
        height: 180px;
        object-fit: contain;
    }

    /* Responsive adjustments */
    @media (max-width: 900px) {
        .prize-grid { display: none; } /* Hide complex grid on mobile for simplicity */
        .ribbon {
            width: 100%;
            padding: 10px;
            font-size: 11px;
            white-space: normal;
            border-radius: 0;
        }
        .ribbon::before, .ribbon::after {
            display: none;
        }
        .jackpot-title { margin-top: 60px; }
        .jackpot-title h1 { font-size: 48px; }
        
        .jackpot-footer { position: relative; left: 0; right: 0; bottom: 0; flex-direction: column; align-items: center; gap: 20px; margin-top: 30px; }
        .ticket-info { text-align: center; }
        .card-3 { flex-direction: column; gap: 20px; padding: 20px; text-align: center; }
        .card-3-right { text-align: center; }
        .card-4 { flex-direction: column; text-align: center; }
        .card-4-image { margin-top: 20px; }
    }
</style>

<div class="free-money-container">
    <h1 style="text-align: center; color: #333; margin-bottom: 30px; font-size: 28px;">Free Money</h1>
    
    <!-- Banner 1: $10 Free -->
    <% if (!user) { %>
    <div class="promo-card card-1">
        <div class="card-1-content">
            <h2>GET $10 FOR FREE</h2>
            <p>Register now and you will get:</p>
            <p>• $10 free sign up bonus</p>
            <p>• 20% cashback on your first purchase!</p>
            <a href="/register" class="btn-register">Register</a>
        </div>
    </div>
    <% } %>
    
    <!-- Banner 2: Jackpot -->
    <div class="promo-card card-2">
        <div class="ribbon">EVERY CUSTOMER WHO MAKES A $100+ PURCHASE ENTERS</div>
        
        <div class="jackpot-title">
            <h4>WEEKLY</h4>
            <h2>GRAND JACKPOT</h2>
            <h1>$10 000</h1>
            <p>BITCOIN TRANSFER</p>
        </div>
        
        <div class="prize-grid">
            <div class="prize-box p-1">
                <div class="prize-badge">1</div>
                <h3>$10 000</h3><p>Bitcoin Transfer</p>
            </div>
            <div class="prize-box p-2">
                <div class="prize-badge">10</div>
                <h3>$1 000</h3><p>Bitcoin Transfer</p>
            </div>
            <div class="prize-box p-3">
                <div class="prize-badge">20</div>
                <h3>$500</h3><p>Bitcoin Transfer</p>
            </div>
            
            <div class="prize-box p-4">
                <div class="prize-badge">20</div>
                <h3>📱</h3><p>iPhone 17 Pro</p>
            </div>
            <div class="prize-box p-5">
                <div class="prize-badge">10</div>
                <h3>💻</h3><p>Macbook Pro</p>
            </div>
            <div class="prize-box p-6">
                <div class="prize-badge">20</div>
                <h3>$500</h3><p>Bonus Balance</p>
            </div>
        </div>
        
        <p class="jackpot-disclaimer">One ticket is enough to participate in the drawing. Each ticket gives the participant one chance to win. The more tickets you have, the better your chances of winning.</p>
        
        <div class="jackpot-footer">
            <div class="ticket-info">
                <p>Claim your tickets every day and get a chance to win $10 000 and other prizes from TorMart.<br>Received <strong>0 out of 7</strong></p>
                <button class="btn-claim">Claim Ticket</button>
                <button class="btn-winners">All Winners</button>
            </div>
            
            <div class="calendar-ticks">
                <div class="tick">1</div>
                <div class="tick">2</div>
                <div class="tick">3</div>
                <div class="tick">4</div>
                <div class="tick">5</div>
                <div class="tick">6</div>
                <div class="tick">7</div>
            </div>
            
            <div class="countdown">
                <span>Next ticket in</span>
                <div class="time-blocks" id="ticket-timer">
                    <div class="time-block t-h1">0</div>
                    <div class="time-block t-h2">0</div>
                    <span class="time-sep">:</span>
                    <div class="time-block t-m1">0</div>
                    <div class="time-block t-m2">0</div>
                    <span class="time-sep">:</span>
                    <div class="time-block t-s1">0</div>
                    <div class="time-block t-s2">0</div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Banner 3: Next Promo -->
    <div class="promo-card card-3">
        <div>
            <h2>NEW PROMOTION</h2>
            <h3>STARTS SOON</h3>
        </div>
        <div class="card-3-center">
            <h4>GRAND JACKPOT</h4>
            <h1>0.5 BTC</h1>
        </div>
        <div class="card-3-right">
            <p style="font-size: 11px; margin-bottom: 5px; color: #ccc;">Remaining</p>
            <div class="time-blocks" id="promo-timer">
                <div class="time-block p-d1">0</div>
                <div class="time-block p-d2">0</div>
                <span class="time-sep">:</span>
                <div class="time-block p-h1">0</div>
                <div class="time-block p-h2">0</div>
                <span class="time-sep">:</span>
                <div class="time-block p-m1">0</div>
                <div class="time-block p-m2">0</div>
                <span class="time-sep">:</span>
                <div class="time-block p-s1">0</div>
                <div class="time-block p-s2">0</div>
            </div>
        </div>
    </div>
    
    <!-- Banner 4: Journey -->
    <div class="promo-card card-4">
        <div class="card-4-content">
            <h2>START YOUR MONEY<br>JOURNEY NOW!</h2>
            <p>TorMart offers you a simple job from the comfort of your own home! All you need is a computer and 2 hours a day!</p>
            <a href="/job" class="btn-outline">Learn More</a>
        </div>
        <img src="/images/promo_money.png" alt="Money" class="card-4-image">
    </div>
</div>

<script>
    const ticketTimerEndStr = "<%= typeof promoSettings !== 'undefined' ? promoSettings.ticket_timer_end : '' %>";
    const promoTimerEndStr = "<%= typeof promoSettings !== 'undefined' ? promoSettings.promo_timer_end : '' %>";

    function pad(num) { return num.toString().padStart(2, '0'); }
    
    function updateDigit(selector, val) {
        const el = document.querySelector(selector);
        if (el) el.textContent = val;
    }

    function updateTimers() {
        const now = new Date().getTime();

        // Ticket Timer (HH:MM:SS)
        if (ticketTimerEndStr) {
            let distance = new Date(ticketTimerEndStr).getTime() - now;
            if (distance < 0) distance = 0;
            const h = pad(Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)));
            const m = pad(Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60)));
            const s = pad(Math.floor((distance % (1000 * 60)) / 1000));
            updateDigit('#ticket-timer .t-h1', h[0]); updateDigit('#ticket-timer .t-h2', h[1]);
            updateDigit('#ticket-timer .t-m1', m[0]); updateDigit('#ticket-timer .t-m2', m[1]);
            updateDigit('#ticket-timer .t-s1', s[0]); updateDigit('#ticket-timer .t-s2', s[1]);
        }

        // Promo Timer (DD:HH:MM:SS)
        if (promoTimerEndStr) {
            let distance = new Date(promoTimerEndStr).getTime() - now;
            if (distance < 0) distance = 0;
            const d = pad(Math.floor(distance / (1000 * 60 * 60 * 24)));
            const h = pad(Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)));
            const m = pad(Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60)));
            const s = pad(Math.floor((distance % (1000 * 60)) / 1000));
            updateDigit('#promo-timer .p-d1', d[0]); updateDigit('#promo-timer .p-d2', d[1]);
            updateDigit('#promo-timer .p-h1', h[0]); updateDigit('#promo-timer .p-h2', h[1]);
            updateDigit('#promo-timer .p-m1', m[0]); updateDigit('#promo-timer .p-m2', m[1]);
            updateDigit('#promo-timer .p-s1', s[0]); updateDigit('#promo-timer .p-s2', s[1]);
        }
    }

    setInterval(updateTimers, 1000);
    updateTimers();
</script>

<%- include('footer') %>
