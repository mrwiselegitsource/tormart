<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TorMart Marketplace</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>
    <header class="top-header">
        <div class="brand">
            <a href="/"><img src="/images/logo.png" alt="TorMart" style="max-height: 40px; display: block;" onerror="this.outerHTML='TorMart<span>★</span>'"></a>
        </div>
        
        <nav class="top-nav">
            <% if (user) { %>
                <a href="/profile">My Profile</a>
                <a href="/free-money">Free Money</a>
                <a href="/reviews" style="color: var(--primary-yellow);">Proofs / Reviews</a>
                <a href="/forum">Forum</a>
                <a href="/faq">Wiki</a>
                <a href="/dashboard">Order History</a>
                <a href="/escrow">Escrow</a>
                <a href="/support">Support</a>
                <a href="/messages">Messages</a>
                <% if (user.role === 'admin') { %>
                    <a href="/admin" style="color: #ff9800;">Admin</a>
                <% } %>
                <% if (user.is_vendor === 1) { %>
                    <a href="/vendor" style="color: #28a745;">Vendor Area</a>
                <% } %>
                <a href="/logout">Logout</a>
            <% } else { %>
                <a href="/login">Login / Register</a>
                <a href="/free-money">Free Money</a>
                <a href="/reviews" style="color: var(--primary-yellow);">Proofs / Reviews</a>
                <a href="/forum">Forum</a>
                <a href="/faq">Wiki</a>
                <a href="/escrow">Escrow</a>
                <a href="/login">Support</a>
                <a href="/login">Messages</a>
            <% } %>
        </nav>
        
        <div style="display: flex; align-items: center; gap: 20px;">
            <a href="/cart" class="cart-icon" style="color: white; text-decoration: none; display: flex; align-items: center; gap: 4px;">
                <img src="/images/cart-icon.png" alt="Cart" style="height: 18px; object-fit: contain;">
                <% if (cartCount > 0) { %>
                    <span class="cart-badge"><%= cartCount %></span>
                <% } %>
            </a>
            
            <!-- Hamburger Icon (Mobile Only) -->
            <div class="hamburger-menu" onclick="toggleMobileMenu()">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </header>

    <!-- Mobile Menu Overlay -->
    <div class="mobile-menu-overlay" id="mobileMenuOverlay" onclick="toggleMobileMenu()"></div>

    <!-- Scripts for Mobile Menu -->
    <script>
        function toggleMobileMenu() {
            document.querySelector('.top-nav').classList.toggle('active');
            document.querySelector('.hamburger-menu').classList.toggle('active');
            document.getElementById('mobileMenuOverlay').classList.toggle('active');
            document.body.classList.toggle('menu-open');
        }
    </script>

    <div class="sub-nav">
        <a href="/category/Carding">Carding</a>
        <a href="/category/Money Transfers">Money Transfers</a>
        <a href="/category/Gift Cards">Gift Cards</a>
        <a href="/category/Cryptocurrency">Cryptocurrency</a>
        <a href="/category/Fake money">Fake money</a>
        <a href="/category/Hacking">Hacking</a>
        <a href="/category/Documents">Documents</a>
        <a href="/category/Electronics">Electronics</a>
        <a href="/category/Porn">Porn</a>
        <a href="/category/Casino Betting">Casino/Betting</a>
    </div>
