<%- include('header') %>

<style>
    .catalog-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 15px; margin-bottom: 50px; }
    .features-bar { display: flex; justify-content: space-between; align-items: center; text-align: center; font-size: 12px; color: #333; }
    .vendor-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 25px; margin-bottom: 40px; }
    .banner-row { display: flex; gap: 20px; }
    .banner-row img { width: 50%; height: 160px; object-fit: cover; border-radius: 6px; box-shadow: 0 4px 10px rgba(0,0,0,0.1); }
    .hero-buttons { display: flex; gap: 15px; justify-content: center; margin-bottom: 45px; }
    .partners-row { display: flex; gap: 40px; justify-content: center; opacity: 0.5; align-items: center; filter: grayscale(100%) brightness(200%); }
    .tracking-bar { display: flex; gap: 10px; max-width: 500px; }
    @media (max-width: 1024px) {
        .catalog-grid { grid-template-columns: repeat(3, 1fr); }
        .vendor-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 768px) {
        .catalog-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
        .vendor-grid { grid-template-columns: 1fr; }
        .features-bar { flex-direction: column; gap: 15px; }
        .features-bar > div { border-left: none !important; border-bottom: 1px solid #e2e8f0; padding-bottom: 15px; }
        .banner-row { flex-direction: column; }
        .banner-row img { width: 100%; }
        .hero-buttons { flex-direction: column; align-items: center; gap: 10px; }
        .partners-row { flex-wrap: wrap; gap: 20px; }
        .partners-row img { height: 25px !important; }
        .tracking-bar { flex-direction: column; max-width: 100%; gap: 10px; }
        .tracking-section { background-position: right top !important; background-size: 90%, auto !important; padding-top: 130px !important; }
        .tracking-input, .tracking-btn { border-radius: 4px !important; }
    }
    @media (max-width: 480px) {
        .catalog-grid { grid-template-columns: repeat(2, 1fr); }
    }
    
    /* Moving Blue Gradient Effect (Ambient Orbs) */
    .hero-wrapper {
        position: relative;
        overflow: hidden;
    }
    
    .ambient-orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(50px);
        opacity: 0.6;
        pointer-events: none;
        z-index: 1;
        mix-blend-mode: screen;
        animation: orbitAntiClockwise 25s infinite linear;
    }

    .orb-1 {
        width: 350px;
        height: 350px;
        background: radial-gradient(circle, rgba(14, 165, 233, 0.5) 0%, rgba(59, 130, 246, 0.2) 60%, transparent 100%);
        top: -50px;
        left: 20%;
        animation-duration: 30s;
    }

    .orb-2 {
        width: 450px;
        height: 450px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.4) 0%, rgba(99, 102, 241, 0.15) 60%, transparent 100%);
        bottom: -100px;
        right: 10%;
        animation-duration: 40s;
    }
    
    .orb-3 {
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(139, 92, 246, 0.4) 0%, rgba(14, 165, 233, 0.2) 60%, transparent 100%);
        top: 40%;
        left: 50%;
        animation-duration: 35s;
    }

    @keyframes orbitAntiClockwise {
        0% { transform: rotate(360deg) translateX(120px) rotate(-360deg); opacity: 0.4; }
        50% { opacity: 0.7; }
        100% { transform: rotate(0deg) translateX(120px) rotate(0deg); opacity: 0.4; }
    }
</style>

<!-- FULL WIDTH HERO SECTION -->
<div class="hero-wrapper" style="background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.8)), url('/images/hero-bg.jpg'); background-size: cover; background-position: center; padding: 100px 20px; text-align: center; color: white;">
    <!-- Ambient Light Orbs -->
    <div class="ambient-orb orb-1"></div>
    <div class="ambient-orb orb-2"></div>
    <div class="ambient-orb orb-3"></div>
    
    <div style="position: relative; z-index: 2;">
        <h1 class="hero-title" style="font-size: 46px; margin-bottom: 25px; font-weight: 800; text-transform: uppercase;">YOUR SECURE SHOPPING</h1>
        <p style="font-size: 18px; margin-bottom: 35px; max-width: 650px; margin-left: auto; margin-right: auto; line-height: 1.6; font-family: Georgia, serif; color: #e2e8f0;">
            TorMart is a secure and anonymous marketplace with Multisig Escrow System. Here you can find trusted sellers and buy the most popular products in DeepWeb
        </p>
        
        <div class="hero-buttons">
            <a href="/register" class="btn" style="background: #a855f7; color: white; padding: 12px 40px; font-size: 16px; font-weight: bold; border-radius: 6px; text-decoration: none; display: flex; flex-direction: column; line-height: 1.2;">REGISTER<span style="font-size: 9px; font-weight: normal; opacity: 0.9;">Get $10 for free</span></a>
            <a href="/login" class="btn" style="background: rgba(0,0,0,0.6); color: white; padding: 12px 40px; font-size: 16px; font-weight: bold; border-radius: 6px; border: 1px solid #fff; text-decoration: none; display: flex; align-items: center;">LOGIN</a>
        </div>

        <!-- Verified Link -->
        <div class="verified-link-container">
            <div style="position: relative; z-index: 2; width: 100%; display: flex; justify-content: space-between; align-items: center;">
                <span style="color: #9ca3af;">Verified Link</span>
                <a id="verified-link-display" href="http://tormartrge7x4244fws34nct54pt5mym2qbjmobunag5rwhirtesgdad.onion/" style="color: white; font-size: 13px; margin: 0 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 40vw; text-decoration: none;">http://tormartrge7x4244fws34nct54pt5mym2qbjmobunag5rwhirtesgdad.onion/</a>
                <script>
                    try {
                        const verifiedLink = document.getElementById('verified-link-display');
                        if (verifiedLink && window.location.origin && !window.location.origin.includes('null')) {
                            const currentUrl = window.location.origin + '/';
                            verifiedLink.href = currentUrl;
                            verifiedLink.textContent = currentUrl;
                        }
                    } catch (e) {}
                </script>
                <a href="#" style="color: #a855f7; text-decoration: none; display: flex; align-items: center; gap: 4px;">★ Add Bookmark</a>
            </div>
        </div>

        <!-- Partners Row -->
        <div class="partners-row">
            <img src="/images/partner-1.png" alt="Deep Web Sites Links" style="height: 35px; object-fit: contain;">
            <img src="/images/partner-2.png" alt="TORCH" style="height: 35px; object-fit: contain;">
            <img src="/images/partner-3.png" alt="Tor Hidden Wiki Fresh 2026" style="height: 35px; object-fit: contain;">
            <img src="/images/partner-4.png" alt="Deep Web Links Planet" style="height: 35px; object-fit: contain;">
            <img src="/images/partner-5.png" alt="Excavator" style="height: 35px; object-fit: contain;">
        </div>
    </div>
</div>

<!-- FEATURES BAR -->
<div style="background: white; padding: 20px 0; border-bottom: 1px solid #e2e8f0;">
    <div class="container features-bar" style="font-size: 12px; color: #333; text-align: center;">
        <div style="flex: 1; padding: 15px 10px;">
            <div style="margin-bottom: 12px;"><img src="/images/icon-value.png" alt="Great Value" style="height: 40px; object-fit: contain;"></div>
            <strong style="display:block; margin-bottom:5px; font-size: 14px; color: #111;">Great Value</strong>
            <span style="color: #666; font-size: 12px; line-height: 1.4; display: block;">We offer competitive prices<br>on our 1000+ product<br>range</span>
        </div>
        <div style="flex: 1; border-left: 1px solid #e2e8f0; padding: 15px 10px;">
            <div style="margin-bottom: 12px;"><img src="/images/icon-delivery.png" alt="Worldwide Delivery" style="height: 40px; object-fit: contain;"></div>
            <strong style="display:block; margin-bottom:5px; font-size: 14px; color: #111;">Worldwide Delivery</strong>
            <span style="color: #666; font-size: 12px; line-height: 1.4; display: block;">We ship to over 150<br>countries & regions</span>
        </div>
        <div style="flex: 1; border-left: 1px solid #e2e8f0; padding: 15px 10px;">
            <div style="margin-bottom: 12px;"><img src="/images/icon-payment.png" alt="Safe Payment" style="height: 40px; object-fit: contain;"></div>
            <strong style="display:block; margin-bottom:5px; font-size: 14px; color: #111;">Safe Payment</strong>
            <span style="color: #666; font-size: 12px; line-height: 1.4; display: block;">Pay with the world's most<br>popular and secure<br>payment methods</span>
        </div>
        <div style="flex: 1; border-left: 1px solid #e2e8f0; padding: 15px 10px;">
            <div style="margin-bottom: 12px;"><img src="/images/icon-confidence.png" alt="Shop with Confidence" style="height: 40px; object-fit: contain;"></div>
            <strong style="display:block; margin-bottom:5px; font-size: 14px; color: #111;">Shop with Confidence</strong>
            <span style="color: #666; font-size: 12px; line-height: 1.4; display: block;">Our Buyer Protection<br>covers your purchase from<br>click to delivery</span>
        </div>
        <div style="flex: 1; border-left: 1px solid #e2e8f0; padding: 15px 10px;">
            <div style="margin-bottom: 12px;"><img src="/images/icon-support.png" alt="24/7 Help Center" style="height: 40px; object-fit: contain;"></div>
            <strong style="display:block; margin-bottom:5px; font-size: 14px; color: #111;">24/7 Help Center</strong>
            <span style="color: #666; font-size: 12px; line-height: 1.4; display: block;">Round-the-clock<br>assistance for a smooth<br>shopping experience</span>
        </div>
    </div>
</div>

<!-- TRACKING ORDER BAR -->
<div class="tracking-section" style="background: url('/images/globe.png') no-repeat right center, linear-gradient(to right, #2c1044 0%, #66329c 60%, #8540c4 100%); background-size: 50%, auto; padding: 40px 0;">
    <div class="container" style="display: flex; flex-direction: column; gap: 12px; position: relative; z-index: 2;">
        <h3 style="color: white; margin: 0; font-size: 20px; font-weight: bold;">Tracking Order</h3>
        <form action="/track-order" method="POST" class="tracking-bar" style="display:flex;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="text" name="tracking_id" class="tracking-input" placeholder="Enter your Tracking ID (e.g. TRK-4A2F8E1B)" style="flex: 1; padding: 14px 15px; border: none; border-radius: 4px 0 0 4px; outline: none; font-size: 15px; color: #333;">
            <button type="submit" class="tracking-btn" style="background: var(--primary-yellow); color: black; font-weight: bold; border: none; padding: 14px 30px; border-radius: 0 4px 4px 0; cursor: pointer; font-size: 15px;">Check Order</button>
        </form>
        <p style="color: white; font-size: 11px; margin: 0; font-weight: bold;">Enter your Tracking ID provided by your vendor after payment.</p>
    </div>
</div>

<div class="container" style="margin-top: 40px; margin-bottom: 40px;">
    
    <!-- CATALOG (CATEGORIES) -->
    <h2 style="text-align: center; margin-bottom: 25px; font-size: 22px; color: #111;">Catalog</h2>
    <div class="catalog-grid">
        <% const cats = [
            { name: "Carding", img: "cat-carding.jpg" },
            { name: "PayPal Transfers", img: "cat-paypal.jpg" },
            { name: "Gift Cards", img: "cat-giftcards.jpg" },
            { name: "Crypto currency", img: "cat-crypto.jpg" },
            { name: "Fake Money", img: "cat-money.jpg" },
            { name: "Accounts", img: "cat-accounts.jpg" },
            { name: "Documents", img: "cat-documents.jpg" },
            { name: "Electronics", img: "cat-electronics.jpg" },
            { name: "18+ items", img: "cat-18plus.jpg" },
            { name: "Casino / Bets", img: "cat-casino.jpg" }
        ]; %>
        
        <% cats.forEach(cat => { %>
            <a href="/category/<%= encodeURIComponent(cat.name) %>" class="category-tile" style="position: relative; height: 130px; border-radius: 8px; overflow: hidden; display: block; text-decoration: none; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">
                <img src="/images/<%= cat.img %>" alt="<%= cat.name %>" style="width: 100%; height: 100%; object-fit: cover;">
                <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0) 60%); display: flex; align-items: flex-end; padding: 12px;">
                    <span style="color: white; font-weight: bold; font-size: 13px;"><%= cat.name %></span>
                </div>
            </a>
        <% }) %>
    </div>

    <!-- MID BANNERS -->
    <%- include('_advert_carousel', { advert_count: 2, pageKey: 'home' }) %>

    <!-- POPULAR VENDORS GRID -->
    <h2 style="text-align: center; margin-bottom: 35px; font-size: 22px; color: #111;">Popular Vendors</h2>
    
    <div class="vendor-grid">
        <% vendors.forEach(vendor => { %>
            <div class="vendor-card" style="background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); position: relative; border: 1px solid #e2e8f0; display: flex; flex-direction: column;">
                
                <!-- Vendor Banner -->
                <div style="height: 110px; background-image: url('<%= vendor.vendor_banner || '/images/default-vendor-banner.jpg' %>'); background-size: cover; background-position: center;"></div>
                
                <!-- Vendor Avatar -->
                <div style="display: flex; justify-content: center; margin-top: -45px;">
                    <a href="/<%= slugify(vendor.vendor_name || vendor.username) %>" style="display: block;">
                        <img src="<%= vendor.vendor_logo || '/images/default-vendor-logo.png' %>" alt="<%= vendor.vendor_name %>" style="width: 90px; height: 90px; border-radius: 50%; border: 4px solid white; object-fit: cover; background: white; transition: transform 0.2s ease;">
                    </a>
                </div>
                
                <!-- Vendor Info -->
                <div style="padding: 20px; text-align: center; flex: 1; display: flex; flex-direction: column;">
                    <h3 style="margin: 0 0 8px 0; font-size: 18px; color: #111;"><%= vendor.vendor_name %></h3>
                    <p style="color: #666; font-size: 13px; margin: 0 0 20px 0; height: 38px; overflow: hidden; line-height: 1.4;"><%= vendor.vendor_short_description %></p>
                    
                    <!-- Stats Table -->
                    <div style="text-align: left; font-size: 14px; margin-bottom: 25px; flex: 1;">
                        <div style="display: flex; justify-content: space-between; padding: 10px 12px; background: white;">
                            <span style="color: #999;">Category</span>
                            <span style="color: #007bff;"><%= vendor.category || 'General' %></span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 10px 12px; background: #f4f4f4;">
                            <span style="color: #999;">Status</span>
                            <span style="color: #28a745;">Online</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 10px 12px; background: white;">
                            <span style="color: #999;">Member Since:</span>
                            <span style="color: #333;">Sep 2021</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 10px 12px; background: #f4f4f4;">
                            <span style="color: #999;">Orders</span>
                            <span style="color: #333;"><%= Math.floor(Math.random() * 5000) + 100 %></span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 10px 12px; background: white;">
                            <span style="color: #999;">Customer protection:</span>
                            <span style="color: #28a745;">Yes</span>
                        </div>
                        <div style="display: flex; justify-content: space-between; padding: 10px 12px; background: #f4f4f4; align-items: center;">
                            <span style="color: #999;">Rating</span>
                            <span style="color: #ff9900; font-size: 20px; letter-spacing: 2px;">★★★★★</span>
                        </div>
                    </div>
                    
                    <div style="text-align: center;">
                        <a href="/<%= slugify(vendor.vendor_name || vendor.username) %>" class="btn" style="background: #6f42c1; color: white; display: inline-block; text-decoration: none; padding: 10px 30px; border-radius: 4px; font-weight: normal; font-size: 15px;">View Vendor</a>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <!-- LOAD MORE -->
    <div style="text-align: center; margin-bottom: 50px;">
        <button class="btn" style="background: #10b981; color: white; padding: 14px 45px; border: none; border-radius: 4px; font-weight: bold; font-size: 16px; cursor: pointer; text-transform: uppercase;">Load More</button>
    </div>

    <!-- BOTTOM BANNERS -->
    <%- include('_advert_carousel', { advert_count: 2, pageKey: 'home' }) %>

</div>

<%- include('footer') %>
