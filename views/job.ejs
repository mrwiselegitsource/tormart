<%- include('header') %>

<div class="job-container">
    <!-- Hero Section -->
    <div class="job-hero">
        <img src="/images/job-hero.png" alt="TorMart Tesla" style="width: 100%; display: block; object-fit: cover; max-height: 500px;">
    </div>
    
    <!-- Title & CTA -->
    <div class="job-title-section">
        <h1>Start your money journey now!</h1>
        <p>TorMart offers you a simple job from the comfort of your own home! All you need is a computer and 2 hours a day!</p>
        <a href="/partner/auth" class="job-btn-green">Start earning</a>
    </div>
    
    <hr class="job-divider">

    <!-- How Does It Work -->
    <div class="job-section">
        <h2 class="job-section-title">HOW DOES IT WORK?</h2>
        <div class="job-steps">
            <div class="job-step">
                <div class="step-circle">1</div>
                <h3>Create an account</h3>
                <p>Create a new account. Add your btc wallet to receive money</p>
                <a href="/partner/auth" class="job-btn-green job-btn-small">Start earning</a>
            </div>
            <div class="job-step">
                <div class="step-circle">2</div>
                <h3>Share your referral link</h3>
                <p>You will get a unique referral link after registering. <span class="job-text-green">SHARE YOUR REFERRAL LINK.</span> Referral link gives a $10 discount to all referred customers for their first purchase</p>
            </div>
            <div class="job-step">
                <div class="step-circle">3</div>
                <h3>Get your money</h3>
                <p><strong>Get up 25%</strong> of the each purchase of each user you attract We make payments to your BTC wallet. Payment is made daily</p>
            </div>
        </div>
    </div>
    
    <hr class="job-divider">

    <!-- Where Can I Share -->
    <div class="job-section">
        <h2 class="job-section-title">WHERE CAN I SHARE A PROMO CODE OR REFERRAL LINK?</h2>
        <div class="job-platforms">
            <div class="job-platform">
                <div class="platform-icon" style="color: #3b82f6;"><i data-lucide="message-square"></i></div>
                <h3>Forums</h3>
                <p>Leave promotional comments on forums. Attach referral link to TorMart.</p>
            </div>
            <div class="job-platform">
                <div class="platform-icon" style="color: #22c55e;"><i data-lucide="file-text"></i></div>
                <h3>Review sites</h3>
                <p>Leave positive reviews on Review websites. Attach referral link to TorMart.</p>
            </div>
            <div class="job-platform">
                <div class="platform-icon" style="color: #ef4444;"><i data-lucide="play-circle"></i></div>
                <h3>YouTube</h3>
                <p>1) Create a video review on TorMart.<br>2) Comment on video clips about DeepWeb.</p>
            </div>
            <div class="job-platform">
                <div class="platform-icon" style="color: #ec4899;"><i data-lucide="camera"></i></div>
                <h3>Telegram Channels</h3>
                <p>Leave comment on the posts in the telegram channels.</p>
            </div>
            <div class="job-platform">
                <div class="platform-icon" style="color: #a855f7;"><i data-lucide="newspaper"></i></div>
                <h3>Blogs</h3>
                <p>Create press releases about TorMart.</p>
            </div>
            <div class="job-platform">
                <div class="platform-icon" style="color: #ec4899;"><i data-lucide="globe"></i></div>
                <h3>Your website</h3>
                <p>Place an advertising banner on your website.</p>
            </div>
        </div>
    </div>
    
    <hr class="job-divider">

    <!-- Top 10 Partners -->
    <div class="job-section">
        <h2 class="job-section-title">TOP 10 PARTNERS</h2>
        <div class="job-tables">
            <div class="job-table-wrapper">
                <div class="job-table-header">BY THE DAY</div>
                <table class="job-table">
                    <% topDailyPartners.forEach((partner, index) => { %>
                        <tr>
                            <td>
                                <% if (index === 0) { %>
                                    <span class="rank-badge red-badge">1</span>
                                <% } else { %>
                                    <%= index + 1 %>. 
                                <% } %>
                                <%= partner.name %>
                            </td>
                            <td class="amount"><%= partner.usd.toLocaleString() %> USD</td>
                        </tr>
                    <% }) %>
                </table>
            </div>
            <div class="job-table-wrapper">
                <div class="job-table-header">BY THE WEEK</div>
                <table class="job-table">
                    <% topWeeklyPartners.forEach((partner, index) => { %>
                        <tr>
                            <td>
                                <% if (index === 0) { %>
                                    <span class="rank-badge red-badge">1</span>
                                <% } else { %>
                                    <%= index + 1 %>. 
                                <% } %>
                                <%= partner.name %>
                            </td>
                            <td class="amount"><%= partner.usd.toLocaleString().replace(/,/g, ' ') %> USD</td>
                        </tr>
                    <% }) %>
                </table>
            </div>
        </div>
    </div>

    <!-- Bottom CTA -->
    <div class="job-bottom-cta">
        <p class="waste-time">DON'T WASTE YOUR TIME</p>
        <h2>EASY JOB - QUICK MONEY - EARN FROM $50 PER DAY!</h2>
        <a href="/partner/auth" class="job-btn-green">Start earning</a>
    </div>
</div>

<%- include('footer') %>
