<div class="bottom-banner-row">
    <a href="<%= banners.bottom1Link || '#' %>" class="bottom-banner">
        <img src="<%= banners.bottom1 %>" alt="Escrow banner" onerror="this.src='/images/placeholder-bottom-banner.svg'">
    </a>
    <a href="<%= banners.bottom2Link || '#' %>" class="bottom-banner">
        <img src="<%= banners.bottom2 %>" alt="Promotional banner" onerror="this.src='/images/placeholder-bottom-banner.svg'">
    </a>
</div>
