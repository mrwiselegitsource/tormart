<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Partner Dashboard | TorMart JOB</title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #f0f2f5;
        }
        * { box-sizing: border-box; }
        .partner-header, .partner-footer {
            background-color: #1e1b4b; /* Dark purple */
            padding: 20px 40px;
            display: flex;
            align-items: center;
        }
        .partner-logo {
            color: white;
            font-size: 24px;
            font-weight: bold;
            text-decoration: none;
            display: flex;
            align-items: center;
        }
    </style>
</head>
<body>

    <!-- Header -->
    <div class="partner-header">
        <a href="/" class="partner-logo">
            <img src="/images/logo.png" alt="TorMart" style="max-height: 30px; margin-right: 5px;"> <span>JOB</span>
        </a>
    </div>

    <!-- Dashboard Content -->
    <div class="dashboard-wrapper">
        <!-- Sidebar -->
        <div class="dashboard-sidebar">
            <!-- Balance Panel -->
            <div class="dash-panel">
                <div class="dash-panel-header">Your Balance</div>
                <div class="dash-panel-content dash-balance">
                    <h2>$0</h2>
                    <h3>0 BTC</h3>
                    <p>Your BTC wallet:</p>
                    <div class="btc-wallet"><%= btc_wallet %></div>
                    <p>Minimum withdrawal amount: 10 USD</p>
                </div>
            </div>

            <!-- Account Menu Panel -->
            <div class="dash-panel">
                <div class="dash-panel-header">Account</div>
                <ul class="dash-menu">
                    <li><a href="/partner/dashboard">Home</a></li>
                    <li><a href="/messages">Support</a></li>
                    <li><a href="#">Change Password</a></li>
                    <li><a href="#">Change Email</a></li>
                    <li><a href="#">Change BTC ADDRESS</a></li>
                    <li><a href="/logout">LogOut</a></li>
                </ul>
            </div>
        </div>

        <!-- Main Content -->
        <div class="dashboard-main">
            <!-- Referral Links Panel -->
            <div class="dash-panel">
                <div class="dash-panel-header">Refferal Links:</div>
                <div class="dash-panel-content" style="padding: 0;">
                    <table class="partner-data-table">
                        <thead>
                            <tr>
                                <th>Link Name</th>
                                <th>URL</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td style="color: #666;">NO NAME</td>
                                <td><strong>http://tormartrge7x4244fws34nct54pt5mym2qbj<br>mobunag5rwhirtesgdad.onion/invite/WY5QS2</strong></td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="dash-panel-content">
                        <div class="dash-form-row">
                            <input type="text" class="dash-input" placeholder="Specify name for new promo link (not required)">
                            <button class="dash-btn-add">+ Add</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Referral Orders Panel -->
            <div class="dash-panel">
                <div class="dash-panel-header">Refferal Orders</div>
                <div class="dash-panel-content" style="text-align: center; color: #888;">
                    There is no orders made by your promo code or link.
                </div>
            </div>

            <!-- Conversion Panel -->
            <div class="dash-panel">
                <div class="dash-panel-header">Conversion</div>
                <div class="dash-panel-content">
                    <div class="conversion-filters">
                        <input type="text" class="dash-input" value="2026/08/11">
                        <input type="text" class="dash-input" value="2026/09/02">
                        <button class="dash-btn-blue">Apply Filter</button>
                    </div>
                </div>
                <table class="partner-data-table">
                    <thead>
                        <tr>
                            <th>Link Name</th>
                            <th style="text-align: center;">Registrations</th>
                            <th style="text-align: center;">Unpaid Orders</th>
                            <th style="text-align: center;">Paid Orders</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="color: #666;">No Name</td>
                            <td style="text-align: center;">1</td>
                            <td style="text-align: center;">0</td>
                            <td style="text-align: center;">0</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Referral Registrations Panel -->
            <div class="dash-panel">
                <div class="dash-panel-header">Refferal Registrations</div>
                <div class="dash-panel-content" style="padding: 0;">
                    <table class="partner-data-table">
                        <thead>
                            <tr>
                                <th>Link Name</th>
                                <th style="text-align: center;">Link Code</th>
                                <th style="text-align: center;">Customer</th>
                                <th style="text-align: center;">Join Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td></td>
                                <td style="text-align: center;">WY5QS2</td>
                                <td style="text-align: center;">ja****23</td>
                                <td style="text-align: center;">2026/08/11</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="partner-footer" style="margin-top: 40px;">
        <a href="/" class="partner-logo">
            <img src="/images/logo.png" alt="TorMart" style="max-height: 30px; margin-right: 5px;"> <span>JOB</span>
        </a>
    </div>

</body>
</html>
