<%- include('header') %>

<style>
    .profile-dashboard {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
        color: #e2e8f0;
        font-family: 'Inter', sans-serif;
    }
    
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 30px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 20px;
    }

    .welcome-text h1 {
        font-size: 2.5rem;
        margin: 0;
        color: #fff;
        font-weight: 800;
        letter-spacing: -1px;
    }
    .welcome-text p {
        margin: 5px 0 0 0;
        color: #94a3b8;
    }

    .dashboard-grid {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 30px;
    }

    @media (max-width: 900px) {
        .dashboard-grid {
            grid-template-columns: 1fr;
        }
        .dashboard-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }
    }

    /* Cards */
    .glass-card {
        background: rgba(30, 15, 45, 0.6); /* Deep Violet */
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
    }
    
    .glass-card h3 {
        margin-top: 0;
        font-size: 1.1rem;
        color: #fff;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 10px;
        margin-bottom: 20px;
        font-weight: 600;
    }

    /* Sidebar Links */
    .nav-menu {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .nav-menu li {
        margin-bottom: 8px;
    }
    .nav-menu a {
        display: flex;
        align-items: center;
        padding: 12px 15px;
        color: #cbd5e1;
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.2s ease;
        font-weight: 500;
        border: 1px solid transparent;
    }
    .nav-menu a:hover, .nav-menu a.active {
        background: rgba(167, 139, 250, 0.15); /* Light Violet/Purple hover */
        color: #d8b4fe;
        border-color: rgba(167, 139, 250, 0.3);
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 15px;
        margin-bottom: 30px;
    }
    .stat-box {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 8px;
        padding: 20px 15px;
        text-align: center;
    }
    .stat-box .val {
        font-size: 1.8rem;
        color: #fff;
        font-weight: 700;
        margin-bottom: 5px;
    }
    .stat-box .lbl {
        font-size: 0.85rem;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Call to Action Button */
    .btn-primary {
        background: #a855f7; /* Purple */
        color: #fff;
        padding: 12px 25px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 700;
        display: inline-block;
        transition: all 0.2s;
        border: none;
        cursor: pointer;
    }
    .btn-primary:hover {
        background: #9333ea;
        transform: translateY(-1px);
    }
    
    .btn-outline {
        border: 1px solid #a855f7;
        color: #d8b4fe;
        padding: 12px 25px;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        display: inline-block;
        transition: all 0.2s;
    }
    .btn-outline:hover {
        background: rgba(168, 85, 247, 0.15);
    }

    /* Category Badges */
    .category-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
    .cat-badge {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        color: #cbd5e1;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        text-decoration: none;
        transition: all 0.2s;
    }
    .cat-badge:hover {
        background: rgba(255,255,255,0.1);
        color: #fff;
        border-color: rgba(255,255,255,0.3);
    }

    /* Vendors Row */
    .vendors-row {
        display: flex;
        gap: 15px;
        overflow-x: auto;
        padding-bottom: 10px;
    }
    .vendors-row::-webkit-scrollbar {
        height: 6px;
    }
    .vendors-row::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,0.2);
        border-radius: 3px;
    }
    .vendor-mini-card {
        min-width: 120px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 8px;
        padding: 15px;
        text-align: center;
        text-decoration: none;
        color: #fff;
        transition: all 0.2s;
    }
    .vendor-mini-card:hover {
        background: rgba(255,255,255,0.08);
        transform: translateY(-2px);
    }
    .vendor-mini-card img {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        margin-bottom: 10px;
        object-fit: cover;
    }
    .vendor-mini-card .v-name {
        font-size: 0.9rem;
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Panels */
    .dynamic-panel { display: none; }
    .dynamic-panel.active { display: block; animation: fadeIn 0.3s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }

    /* Forms */
    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; margin-bottom: 8px; color: #94a3b8; font-size: 0.9rem; }
    .form-control {
        width: 100%;
        padding: 12px 15px;
        background: rgba(0,0,0,0.2);
        border: 1px solid rgba(255,255,255,0.1);
        color: #fff;
        border-radius: 6px;
        box-sizing: border-box;
    }
    .form-control:focus {
        outline: none;
        border-color: #a855f7;
    }
    .profile-wrapper {
        background-color: #130822; /* Very deep violet */
        min-height: calc(100vh - 100px);
        padding: 1px 0 40px 0;
    }
</style>

<div class="profile-wrapper">
<div class="profile-dashboard">
    
    <% if (typeof req !== 'undefined' && req.query && req.query.error) { %>
        <div style="background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; color: #fca5a5; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
            <%= req.query.error %>
        </div>
    <% } %>
    <% if (typeof req !== 'undefined' && req.query && req.query.success) { %>
        <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid #10b981; color: #6ee7b7; padding: 15px; border-radius: 8px; margin-bottom: 20px;">
            <%= req.query.success %>
        </div>
    <% } %>

    <div class="dashboard-header">
        <div class="welcome-text">
            <h1>Welcome back, <%= username %></h1>
            <p>Access your orders, support, and account settings.</p>
        </div>
        <div style="display: flex; gap: 15px; align-items: center;">
            <div style="text-align: right; margin-right: 15px;">
                <div style="color: #94a3b8; font-size: 0.9rem;">Bonus Balance</div>
                <div style="color: #fff; font-size: 1.2rem; font-weight: 700;"><%= bonusBtc %> BTC</div>
            </div>
            <a href="/" class="btn-primary">Browse Market</a>
        </div>
    </div>

    <div class="dashboard-grid">
        
        <!-- Left Sidebar -->
        <div class="sidebar">
            <div class="glass-card" style="margin-bottom: 20px; text-align: center;">
                <img src="<%= avatar %>" alt="<%= tier %>" style="width: 80px; height: 80px; border-radius: 50%; margin-bottom: 15px; border: 2px solid rgba(255,255,255,0.1); padding: 5px;">
                <h3 style="border: none; margin-bottom: 5px; font-size: 1.2rem;"><%= tier %> Member</h3>
                <p style="color: #94a3b8; font-size: 0.9rem; margin: 0;">Level up by completing orders.</p>
            </div>

            <div class="glass-card">
                <h3>Account Navigation</h3>
                <ul class="nav-menu">
                    <li><a href="#" onclick="switchPanel('overview-panel', this)" class="nav-link active">Dashboard Overview</a></li>
                    <li><a href="/messages">Messages</a></li>
                    <li><a href="/support">Support Tickets</a></li>
                    <li><a href="#" onclick="switchPanel('orders-panel', this)" class="nav-link">Order History</a></li>
                    <li><a href="#" onclick="switchPanel('password-panel', this)" class="nav-link">Security Settings</a></li>
                    <li style="margin-top: 20px;"><a href="/logout" style="color: #fca5a5;">Sign Out</a></li>
                </ul>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="main-content">
            
            <!-- OVERVIEW PANEL -->
            <div id="overview-panel" class="dynamic-panel active">
                
                <div class="glass-card" style="margin-bottom: 30px;">
                    <h3>Quick Categories</h3>
                    <div class="category-badges">
                        <% 
                            const safeCategories = (typeof categories !== 'undefined' && categories) ? categories : ['Gift Cards', 'Software', 'Digital'];
                            safeCategories.forEach(cat => { 
                        %>
                            <a href="/category/<%= encodeURIComponent(cat) %>" class="cat-badge"><%= cat %></a>
                        <% }) %>
                    </div>
                </div>

                <% 
                    const safeVendors = (typeof vendors !== 'undefined' && vendors) ? vendors : [];
                    if (safeVendors.length > 0) { 
                %>
                <div class="glass-card" style="margin-bottom: 30px;">
                    <h3>Verified Vendors Spotlight</h3>
                    <div class="vendors-row">
                        <% safeVendors.forEach(v => { %>
                            <a href="/vendor/<%= encodeURIComponent(v.vendor_name) %>" class="vendor-mini-card">
                                <img src="<%= v.vendor_logo || '/images/default-vendor.png' %>" alt="<%= v.vendor_name %>" onerror="this.src='/images/default-vendor.png'">
                                <div class="v-name"><%= v.vendor_name %></div>
                            </a>
                        <% }) %>
                    </div>
                </div>
                <% } %>

                <div class="glass-card" style="background: linear-gradient(135deg, rgba(30,15,45,0.8), rgba(45,20,70,0.8));">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px;">
                        <h3 style="margin: 0; border: none; padding: 0;">Vendor Partnership</h3>
                        <% if (user.is_vendor === 1) { %>
                            <span style="background: rgba(16,185,129,0.2); color: #6ee7b7; padding: 4px 10px; border-radius: 4px; font-size: 0.85rem;">Active Vendor</span>
                        <% } else if (user.vendor_status === 'pending') { %>
                            <span style="background: rgba(245,158,11,0.2); color: #fcd34d; padding: 4px 10px; border-radius: 4px; font-size: 0.85rem;">Review Pending</span>
                        <% } %>
                    </div>
                    
                    <p style="color: #cbd5e1; margin-bottom: 20px; line-height: 1.6;">
                        <% if (user.is_vendor === 1) { %>
                            Manage your digital products, view incoming orders, and handle customer support inquiries directly from your isolated Vendor Area.
                        <% } else if (user.vendor_status === 'pending') { %>
                            Your application is currently being reviewed by our administration team. We will notify you once your vendor status is approved.
                        <% } else { %>
                            Want to sell on Tormart? Apply to become a verified vendor, reach our massive buyer network, and benefit from our secure escrow system.
                        <% } %>
                    </p>

                    <div>
                        <% if (user.is_vendor === 1) { %>
                            <a href="/vendor" class="btn-primary">Access Vendor Area &rarr;</a>
                        <% } else if (user.vendor_status === 'pending') { %>
                            <a href="/apply-vendor" class="btn-outline">Check Application Status</a>
                        <% } else { %>
                            <a href="/apply-vendor" class="btn-primary">Become a Vendor</a>
                        <% } %>
                    </div>
                </div>

            </div>

            <!-- ORDERS PANEL -->
            <div id="orders-panel" class="dynamic-panel">
                <div class="glass-card">
                    <h3>Order History</h3>
                    <div class="stats-grid">
                        <div class="stat-box">
                            <div class="val" style="color: #94a3b8;"><%= orderStats.unpaid %></div>
                            <div class="lbl">Unpaid</div>
                        </div>
                        <div class="stat-box">
                            <div class="val" style="color: #fcd34d;"><%= orderStats.processing %></div>
                            <div class="lbl">Processing</div>
                        </div>
                        <div class="stat-box">
                            <div class="val" style="color: #6ee7b7;"><%= orderStats.shipping %></div>
                            <div class="lbl">Shipping</div>
                        </div>
                        <div class="stat-box">
                            <div class="val" style="color: #d8b4fe;"><%= orderStats.waiting_review %></div>
                            <div class="lbl">Waiting Review</div>
                        </div>
                    </div>
                    
                    <div style="text-align: center; margin-top: 30px;">
                        <a href="/dashboard" class="btn-outline">View Detailed Order Log</a>
                    </div>
                </div>
            </div>
            
            <!-- PASSWORD PANEL -->
            <div id="password-panel" class="dynamic-panel">
                <div class="glass-card">
                    <h3>Security Settings</h3>
                    <form action="/profile/change-password" method="POST" style="max-width: 400px;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="form-group">
                            <label>Current Password</label>
                            <input type="password" name="old_password" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>New Password</label>
                            <input type="password" name="new_password" class="form-control" required>
                        </div>
                        <div class="form-group">
                            <label>Confirm New Password</label>
                            <input type="password" name="confirm_password" class="form-control" required>
                        </div>
                        <button type="submit" class="btn-primary" style="width: 100%; margin-top: 10px;">Update Password</button>
                    </form>
                </div>
            </div>
            
        </div>
    </div>
</div>
</div>

<script>
    function switchPanel(panelId, element) {
        // Hide all panels
        document.querySelectorAll('.dynamic-panel').forEach(p => p.classList.remove('active'));
        // Show target panel
        document.getElementById(panelId).classList.add('active');
        
        // Update active class on nav links
        document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
        element.classList.add('active');
    }
</script>

<%- include('footer') %>
