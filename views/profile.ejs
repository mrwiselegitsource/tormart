<%- include('header') %>

<style>
    .profile-dashboard {
        max-width: 1200px;
        margin: 40px auto;
        padding: 20px;
        color: #fff;
        font-family: 'Inter', sans-serif;
    }
    .profile-header {
        font-size: 2rem;
        margin-bottom: 30px;
        font-weight: 700;
        text-transform: uppercase;
    }
    .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }
    .dashboard-card {
        background: #2a1f43; /* slightly lighter than deep background */
        border-radius: 12px;
        padding: 25px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }
    .dashboard-card h2 {
        font-size: 1.2rem;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--primary-yellow, #ffc107);
    }
    .bonus-amount {
        font-size: 2.5rem;
        font-weight: 800;
        margin: 10px 0;
    }
    .bonus-usd {
        color: #aaa;
        font-size: 1.1rem;
    }
    .membership-tier {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
    }
    .membership-tier img {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: rgba(255,255,255,0.1);
        padding: 5px;
    }
    .tier-info h3 {
        margin: 0 0 5px 0;
        font-size: 1.4rem;
    }
    .tier-info p {
        margin: 0;
        color: #bbb;
        font-size: 0.9rem;
    }
    .account-nav {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .account-nav li {
        margin-bottom: 10px;
    }
    .account-nav a {
        display: block;
        padding: 12px 15px;
        background: rgba(255,255,255,0.05);
        color: #fff;
        text-decoration: none;
        border-radius: 8px;
        transition: 0.3s;
    }
    .account-nav a:hover, .account-nav a.active {
        background: var(--primary-yellow, #ffc107);
        color: #000;
        font-weight: bold;
    }
    
    .orders-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }
    .order-stat {
        background: rgba(255,255,255,0.05);
        padding: 20px;
        border-radius: 8px;
        text-align: center;
    }
    .order-stat .num {
        font-size: 2rem;
        font-weight: bold;
        color: var(--primary-yellow, #ffc107);
        margin-bottom: 5px;
    }
    .order-stat .label {
        font-size: 0.9rem;
        color: #aaa;
    }
    
    /* Dynamic Panels */
    .dynamic-panel { display: none; }
    .dynamic-panel.active { display: block; }
    
    /* Forms */
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; margin-bottom: 5px; color: #ccc; }
    .form-control {
        width: 100%;
        padding: 12px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.2);
        color: #fff;
        border-radius: 6px;
    }
    .btn-submit {
        background: var(--primary-yellow, #ffc107);
        color: #000;
        border: none;
        padding: 12px 20px;
        font-weight: bold;
        border-radius: 6px;
        cursor: pointer;
        width: 100%;
    }
</style>

<div class="profile-dashboard">
    <div class="profile-header">MY PROFILE</div>
    
    <% if (typeof req !== 'undefined' && req.query && req.query.error) { %>
        <div style="background: #ef4444; color: white; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
            <%= req.query.error %>
        </div>
    <% } %>
    <% if (typeof req !== 'undefined' && req.query && req.query.success) { %>
        <div style="background: #10b981; color: white; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
            <%= req.query.success %>
        </div>
    <% } %>

    <div class="dashboard-grid">
        
        <!-- Bonus Balance -->
        <div class="dashboard-card">
            <h2>✨ Bonus Balance</h2>
            <div style="color: #aaa; margin-bottom: 5px;">Your balance</div>
            <div class="bonus-amount"><%= bonusBtc %> BTC</div>
            <div class="bonus-usd">$<%= parseFloat(bonusUsd).toFixed(2) %></div>
        </div>
        
        <!-- Membership Status -->
        <div class="dashboard-card">
            <h2>👑 Membership Status</h2>
            <div class="membership-tier">
                <img src="<%= avatar %>" alt="<%= tier %> Avatar" onerror="this.src='/images/regular-avatar.png'">
                <div class="tier-info">
                    <h3><%= tier %> Buyer</h3>
                    <p>You will get a Bonus after each purchase!</p>
                </div>
            </div>
            <div style="background: rgba(0,0,0,0.2); padding: 10px; border-radius: 8px; font-size: 0.85rem; color: #ccc;">
                <strong>Tiers:</strong> Regular (0-3) • Gold (4-6) • Platinum (7+)
            </div>
        </div>
        
        <!-- Account Nav -->
        <div class="dashboard-card">
            <h2>👤 Account</h2>
            <ul class="account-nav">
                <li><a href="/messages">Messages</a></li>
                <li><a href="/support">Support</a></li>
                <li><a href="#" onclick="switchPanel('orders-panel', this)" class="nav-link active">Order History</a></li>
                <li><a href="#" onclick="switchPanel('password-panel', this)" class="nav-link">Change Password</a></li>
                <li><a href="/logout">LogOut</a></li>
            </ul>
        </div>
        
        <!-- Dynamic Right Panel -->
        <div class="dashboard-card" style="position: relative;">
            
            <!-- Orders Panel -->
            <div id="orders-panel" class="dynamic-panel active">
                <h2>📦 Order History</h2>
                <div class="orders-grid">
                    <div class="order-stat">
                        <div class="num"><%= orderStats.unpaid %></div>
                        <div class="label">Unpaid</div>
                    </div>
                    <div class="order-stat">
                        <div class="num"><%= orderStats.processing %></div>
                        <div class="label">Processing</div>
                    </div>
                    <div class="order-stat">
                        <div class="num"><%= orderStats.shipping %></div>
                        <div class="label">Shipping</div>
                    </div>
                    <div class="order-stat">
                        <div class="num"><%= orderStats.waiting_review %></div>
                        <div class="label">Waiting review</div>
                    </div>
                </div>
                <div style="text-align: center; margin-top: 20px;">
                    <a href="/dashboard" style="color: var(--primary-yellow, #ffc107); text-decoration: none;">View All Orders &rarr;</a>
                </div>
            </div>
            
            <!-- Change Password Panel -->
            <div id="password-panel" class="dynamic-panel">
                <h2>🔒 Change Password</h2>
                <form action="/profile/change-password" method="POST">
                    <div class="form-group">
                        <label>Old Password</label>
                        <input type="password" name="old_password" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>New Password</label>
                        <input type="password" name="new_password" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Confirm New Password</label>
                        <input type="password" name="confirm_password" class="form-control" required>
                    </div>
                    <button type="submit" class="btn-submit">Update Password</button>
                </form>
            </div>
            
        </div>
        
    </div>
</div>

<script>
    function switchPanel(panelId, element) {
        // Hide all panels
        document.querySelectorAll('.dynamic-panel').forEach(p => p.classList.remove('active'));
        // Show target panel
        document.getElementById(panelId).classList.add('active');
        
        // Update active class on nav links
        document.querySelectorAll('.nav-link').forEach(l => l.classList.remove('active'));
        element.classList.add('active');
    }
</script>

<%- include('footer') %>
