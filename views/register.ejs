<%- include('header') %>

<div class="container" style="max-width: 400px;">
    <div class="form-panel">
        <h2 style="text-align: center; margin-bottom: 20px; color: #111;">Register</h2>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div style="background: #fee2e2; color: #ef4444; padding: 10px; border-radius: 4px; margin-bottom: 15px; font-size: 12px; text-align: center;">
                <%= error %>
            </div>
        <% } %>

        <form action="/register" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group">
                <input type="text" name="username" class="form-control" placeholder="Username" required>
            </div>
            <div class="form-group">
                <input type="email" name="email" class="form-control" placeholder="Email" required>
            </div>
            <div class="form-group">
                <input type="password" name="password" class="form-control" placeholder="Password" required>
            </div>
            <button type="submit" class="btn btn-purple btn-block">Register</button>
        </form>
        
        <div style="text-align: center; margin-top: 15px; font-size: 12px;">
            <a href="/login" style="color: var(--primary-purple);">Already have an account? Login</a>
        </div>
    </div>
</div>

<%- include('footer') %>
