<%- include('header') %>

<div class="container" style="max-width: 950px; margin-top: 30px; margin-bottom: 50px;">
    <!-- Seller Dashboard Header -->
    <div style="background: linear-gradient(135deg, var(--bg-header) 0%, #2c1044 100%); color: #fff; padding: 25px 30px; border-radius: 6px 6px 0 0; border-bottom: 3px solid var(--primary-purple); box-shadow: 0 2px 5px rgba(0,0,0,0.15); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
        <div>
            <h1 style="font-size: 22px; font-weight: bold; margin: 0; color: #fff; display: flex; align-items: center; gap: 10px;">
                <span style="color: var(--primary-yellow);">💼</span> Seller & Vendor Center
            </h1>
            <p style="margin: 4px 0 0 0; font-size: 13px; color: #cbd5e1;">Manage merchant operations, listing distribution, and vendor status</p>
        </div>
        <div>
            <% if (user && user.is_vendor === 1) { %>
                <a href="/vendor" class="btn btn-green" style="font-size: 13px; padding: 8px 18px; border-radius: 4px; display: inline-flex; align-items: center; gap: 6px;">
                    <span>⚙️</span> Go to Vendor Area
                </a>
            <% } else { %>
                <a href="/cooperation" class="btn" style="background: var(--primary-yellow); color: #000; font-size: 13px; font-weight: bold; padding: 8px 18px; border-radius: 4px;">
                    Apply to Become a Vendor
                </a>
            <% } %>
        </div>
    </div>

    <!-- Main Seller Panel -->
    <div style="background: #fff; padding: 35px 40px; border-radius: 0 0 6px 6px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); color: #333;">

        <% if (user && user.is_vendor === 1) { %>
            <!-- User is already an Approved Vendor -->
            <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-left: 5px solid var(--primary-green); padding: 20px 25px; border-radius: 4px; margin-bottom: 30px;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px;">
                    <div>
                        <h3 style="margin: 0 0 6px 0; color: #166534; font-size: 17px; font-weight: bold;">
                            ✓ You are an Active Verified Vendor
                        </h3>
                        <p style="margin: 0; color: #15803d; font-size: 13px;">
                            Your vendor account is fully authorized. Please use the dedicated <strong>Vendor Area</strong> to manage your listings, upload proofs, view customer orders, and manage sales.
                        </p>
                    </div>
                    <a href="/vendor" class="btn btn-green" style="padding: 10px 24px; font-size: 14px; font-weight: bold;">
                        Open Vendor Dashboard &rarr;
                    </a>
                </div>
            </div>

            <!-- Quick Store Summary for Active Vendors -->
            <h3 style="font-size: 16px; font-weight: bold; color: #1e293b; margin-bottom: 15px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
                Your Merchant Overview
            </h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 30px;">
                <div style="background: #f8fafc; padding: 20px; border-radius: 6px; border: 1px solid var(--border-color); text-align: center;">
                    <div style="font-size: 28px; font-weight: bold; color: var(--primary-purple); margin-bottom: 4px;">
                        <%= (typeof products !== 'undefined' && products) ? products.length : 0 %>
                    </div>
                    <div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: bold;">Active Listings</div>
                </div>
                <div style="background: #f8fafc; padding: 20px; border-radius: 6px; border: 1px solid var(--border-color); text-align: center;">
                    <div style="font-size: 28px; font-weight: bold; color: var(--primary-green); margin-bottom: 4px;">
                        <%= (typeof orders !== 'undefined' && orders) ? orders.length : 0 %>
                    </div>
                    <div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: bold;">Recent Orders</div>
                </div>
                <div style="background: #f8fafc; padding: 20px; border-radius: 6px; border: 1px solid var(--border-color); text-align: center;">
                    <div style="font-size: 28px; font-weight: bold; color: var(--primary-yellow); margin-bottom: 4px;">
                        <%= user.vendor_status || 'Verified' %>
                    </div>
                    <div style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: bold;">Account Tier</div>
                </div>
            </div>

            <div style="display: flex; gap: 15px; flex-wrap: wrap;">
                <a href="/vendor" class="btn btn-purple" style="padding: 10px 22px; font-size: 13px;">Manage All Listings & Proofs</a>
                <a href="/support" class="btn" style="background: #e2e8f0; color: #334155; padding: 10px 22px; font-size: 13px;">Contact Merchant Support</a>
            </div>

        <% } else { %>
            <!-- User is NOT a Vendor: Apply to Become a Vendor -->
            <div style="text-align: center; max-width: 650px; margin: 0 auto 35px auto;">
                <div style="font-size: 48px; margin-bottom: 15px;">🏪</div>
                <h2 style="font-size: 22px; font-weight: bold; color: #1e293b; margin-bottom: 10px;">
                    Apply to Become a Vendor on TorMart
                </h2>
                <p style="color: #64748b; font-size: 14px; line-height: 1.6;">
                    Expand your digital business to thousands of active buyers worldwide. Benefit from automated multi-currency escrow, instant crypto payouts, and reliable buyer dispute protection.
                </p>
                <div style="margin-top: 20px; display: flex; justify-content: center; gap: 12px; flex-wrap: wrap;">
                    <a href="/cooperation" class="btn btn-purple" style="padding: 12px 28px; font-size: 14px; font-weight: bold;">
                        Apply to Become a Vendor &rarr;
                    </a>
                    <a href="/support" class="btn" style="background: #334155; color: white; padding: 12px 24px; font-size: 14px;">
                        Open Application Ticket
                    </a>
                </div>
            </div>

            <!-- How It Works Grid -->
            <h3 style="font-size: 16px; font-weight: bold; color: #1e293b; margin-bottom: 15px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px;">
                Vendor Onboarding Process
            </h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 15px; margin-bottom: 35px;">
                <div style="background: #f8fafc; padding: 20px; border-radius: 6px; border: 1px solid var(--border-color);">
                    <div style="font-weight: bold; color: var(--primary-purple); margin-bottom: 6px; font-size: 14px;">
                        1. Review Rules & Bond
                    </div>
                    <div style="font-size: 13px; color: #64748b; line-height: 1.5;">
                        Read the <a href="/cooperation" style="color: var(--primary-purple); text-decoration: underline;">Cooperation Policy</a>. Registration requires a security vendor bond deposit, fully refundable upon clean account closure.
                    </div>
                </div>
                <div style="background: #f8fafc; padding: 20px; border-radius: 6px; border: 1px solid var(--border-color);">
                    <div style="font-weight: bold; color: var(--primary-green); margin-bottom: 6px; font-size: 14px;">
                        2. Submit Support Ticket
                    </div>
                    <div style="font-size: 13px; color: #64748b; line-height: 1.5;">
                        Create a support ticket with the subject <strong>"Cooperation"</strong>. Include product categories, stock details, and proof of cross-market reputation.
                    </div>
                </div>
                <div style="background: #f8fafc; padding: 20px; border-radius: 6px; border: 1px solid var(--border-color);">
                    <div style="font-weight: bold; color: #d97706; margin-bottom: 6px; font-size: 14px;">
                        3. List & Earn
                    </div>
                    <div style="font-size: 13px; color: #64748b; line-height: 1.5;">
                        Once approved, access your merchant control panel to upload offers, proof media, manage orders, and withdraw sales revenue.
                    </div>
                </div>
            </div>

            <!-- Prohibited Goods Warning -->
            <div style="background: #fffbeb; border: 1px solid #fef3c7; border-left: 4px solid var(--primary-yellow); padding: 15px 20px; border-radius: 0 4px 4px 0; font-size: 13px; color: #92400e;">
                <strong>Strict Compliance Required:</strong> All vendor applicants must strictly adhere to market safety standards. Products causing bodily harm, weapons, fentanyl, poisons, or illicit media are strictly forbidden and result in permanent ban and bond loss.
            </div>
        <% } %>

    </div>
</div>

<%- include('footer') %>
