<%- include('header') %>

<div class="container" style="max-width: 900px; margin-top: 30px; margin-bottom: 50px;">
    <!-- Page Header Banner -->
    <div style="background: linear-gradient(135deg, var(--bg-header) 0%, #2c1044 100%); color: #fff; padding: 25px 30px; border-radius: 6px 6px 0 0; border-bottom: 3px solid var(--primary-purple); box-shadow: 0 2px 5px rgba(0,0,0,0.15);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div>
                <h1 style="font-size: 24px; font-weight: bold; margin: 0; color: #fff; display: flex; align-items: center; gap: 10px;">
                    <span style="color: var(--primary-yellow);">📜</span> Terms of Service
                </h1>
                <p style="margin: 5px 0 0 0; font-size: 13px; color: #cbd5e1;">Platform Rules, User Obligations, and Trading Protocols</p>
            </div>
            <div style="background: rgba(126, 34, 206, 0.4); border: 1px solid var(--primary-purple); padding: 5px 12px; border-radius: 20px; font-size: 12px; color: #f1f5f9; font-weight: bold;">
                Effective: <span>2019-2026</span>
            </div>
        </div>
    </div>
    
    <!-- Main Content Panel -->
    <div style="background: #fff; padding: 35px 40px; border-radius: 0 0 6px 6px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); color: #333; line-height: 1.7; font-size: 14px;">
        
        <div style="background: #f8fafc; border-left: 4px solid var(--primary-yellow); padding: 15px 20px; border-radius: 0 4px 4px 0; margin-bottom: 30px; font-size: 13px; color: #475569;">
            <strong style="color: #1e293b;">Binding Agreement:</strong> By accessing, registering, or transacting on the TorMart marketplace, you acknowledge and agree to comply with the rules and protocols set forth below.
        </div>

        <!-- Section 1: Acceptance -->
        <div style="margin-bottom: 35px;">
            <h3 style="font-size: 17px; font-weight: bold; color: #1e293b; margin-bottom: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                <span style="color: var(--primary-purple);">1.</span> Acceptance of Terms
            </h3>
            <p style="margin-bottom: 12px; color: #475569;">
                By navigating TorMart, depositing cryptocurrency, listing products, or interacting through our encrypted communication network, you enter into a legally binding operational agreement with the marketplace infrastructure and its community protocols. If you do not agree to these terms, you must immediately terminate use of the platform.
            </p>
        </div>

        <!-- Section 2: Account Responsibilities -->
        <div style="margin-bottom: 35px;">
            <h3 style="font-size: 17px; font-weight: bold; color: #1e293b; margin-bottom: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                <span style="color: var(--primary-purple);">2.</span> Account Responsibilities & Operational Security
            </h3>
            <p style="margin-bottom: 12px; color: #475569;">
                Users hold complete and sole custody over their account security. Platform obligations include:
            </p>
            <ul style="padding-left: 20px; margin-bottom: 12px; color: #475569;">
                <li style="margin-bottom: 6px;"><strong>Credential Custody:</strong> You are responsible for preserving username and password secrecy. TorMart staff will never ask for your password under any circumstance.</li>
                <li style="margin-bottom: 6px;"><strong>Unrecoverable Loss:</strong> Lost passwords cannot be reset by staff due to zero-knowledge account design.</li>
                <li style="margin-bottom: 6px;"><strong>Authorized Actions:</strong> Any order, message, review, or withdrawal executed under your account credentials is deemed authorized by you.</li>
            </ul>
        </div>

        <!-- Section 3: Prohibited Activities -->
        <div style="margin-bottom: 35px;">
            <h3 style="font-size: 17px; font-weight: bold; color: #1e293b; margin-bottom: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                <span style="color: var(--primary-purple);">3.</span> Prohibited Activities & Forbidden Listings
            </h3>
            <p style="margin-bottom: 12px; color: #475569;">
                To preserve marketplace safety and integrity, the following activities and goods are unconditionally prohibited:
            </p>
            <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 4px; padding: 15px 20px; margin-bottom: 15px;">
                <strong style="color: #991b1b; display: block; margin-bottom: 8px;">Zero-Tolerance Prohibitions:</strong>
                <ul style="padding-left: 20px; color: #991b1b; margin-bottom: 0; font-size: 13px;">
                    <li style="margin-bottom: 4px;">Assassinations, physical threats, or services causing bodily harm;</li>
                    <li style="margin-bottom: 4px;">Weapons of mass destruction, chemical, biological, or explosive agents;</li>
                    <li style="margin-bottom: 4px;">Fentanyl and lethal synthetic analogues;</li>
                    <li style="margin-bottom: 4px;">Firearms, ballistic weapons, or lethal ammunition;</li>
                    <li style="margin-bottom: 4px;">Poisons and dangerous toxins;</li>
                    <li style="margin-bottom: 4px;">Child exploitation material or abusive media;</li>
                    <li style="margin-bottom: 4px;">Snuff, torture, murder media or abusive content.</li>
                </ul>
            </div>
            <p style="margin-bottom: 8px; color: #475569;"><strong>Market Conduct Violations:</strong></p>
            <ul style="padding-left: 20px; color: #475569;">
                <li style="margin-bottom: 6px;"><strong>No Direct Deals:</strong> Bypassing marketplace escrow via off-site contacts (Jabber, Telegram, email) is strictly forbidden.</li>
                <li style="margin-bottom: 6px;"><strong>No Self-Rating / Shilling:</strong> Fabricating purchases or manipulating review scores leads to instant vendor termination.</li>
                <li style="margin-bottom: 6px;"><strong>No Unauthorized FE:</strong> Demanding Finalize Early (FE) on standard escrow offers is forbidden.</li>
            </ul>
        </div>

        <!-- Section 4: Limitation of Liability -->
        <div style="margin-bottom: 35px;">
            <h3 style="font-size: 17px; font-weight: bold; color: #1e293b; margin-bottom: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                <span style="color: var(--primary-purple);">4.</span> Limitation of Liability & Cryptocurrency Risks
            </h3>
            <p style="margin-bottom: 12px; color: #475569;">
                TorMart functions as a decentralized escrow platform bridging independent buyers and sellers:
            </p>
            <ul style="padding-left: 20px; margin-bottom: 12px; color: #475569;">
                <li style="margin-bottom: 6px;"><strong>Blockchain Volatility:</strong> The platform is not liable for cryptocurrency network congestion, miner fees, or token exchange rate fluctuations during transaction windows.</li>
                <li style="margin-bottom: 6px;"><strong>Independent Vendors:</strong> Products and listings are created by third-party vendors. The platform enforces escrow guarantees but does not manufacture or warrant external digital assets.</li>
                <li style="margin-bottom: 6px;"><strong>As-Is Operation:</strong> Services are provided on an "as-is" and "as-available" basis without express or implied warranty of uptime.</li>
            </ul>
        </div>

        <!-- Section 5: Dispute Resolution -->
        <div style="margin-bottom: 35px;">
            <h3 style="font-size: 17px; font-weight: bold; color: #1e293b; margin-bottom: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                <span style="color: var(--primary-purple);">5.</span> Dispute Resolution & Arbitration
            </h3>
            <p style="margin-bottom: 12px; color: #475569;">
                In the event of trade disagreements between buyer and vendor:
            </p>
            <ul style="padding-left: 20px; margin-bottom: 12px; color: #475569;">
                <li style="margin-bottom: 6px;"><strong>Support Arbitration:</strong> Either party may summon administrative arbitration by opening a ticket through the <a href="/support" style="color: var(--primary-purple); font-weight: bold;">Support Center</a>.</li>
                <li style="margin-bottom: 6px;"><strong>Evidence Submission:</strong> Both parties are required to provide verifiable objective proof (e.g. proof screenshots, screen recordings, verification logs) within 48 hours.</li>
                <li style="margin-bottom: 6px;"><strong>Final Verdict:</strong> Marketplace administrative rulings are conclusive and final. Escrow funds will be disbursed in accordance with the determination.</li>
            </ul>
        </div>

        <!-- Section 6: Termination -->
        <div>
            <h3 style="font-size: 17px; font-weight: bold; color: #1e293b; margin-bottom: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                <span style="color: var(--primary-purple);">6.</span> Termination & Vendor Bond Forfeiture
            </h3>
            <p style="margin-bottom: 12px; color: #475569;">
                TorMart administration reserves the right to suspend, terminate, or ban accounts for:
            </p>
            <ul style="padding-left: 20px; margin-bottom: 15px; color: #475569;">
                <li style="margin-bottom: 6px;">Breach of any terms or listing forbidden products;</li>
                <li style="margin-bottom: 6px;">Attempted exit-scamming or selective fulfillment by vendors;</li>
                <li style="margin-bottom: 6px;">Malicious exploitation of market vulnerabilities or spam attacks.</li>
            </ul>
            <p style="color: #64748b; font-size: 13px; margin-bottom: 0;">
                In cases of confirmed vendor fraud, the vendor bond deposit will be permanently forfeited and redistributed to impacted victims.
            </p>
        </div>

    </div>
</div>

<%- include('footer') %>
