<%- include('header') %>

<style>
/* ── TRACKING PAGE ── */
.trk-hero {
    background: #fff;
    border-bottom: 4px solid var(--primary-yellow, #f5c518);
    padding: 0;
    overflow: hidden;
    position: relative;
}
.trk-hero img.trk-hero-img {
    width: 100%;
    max-height: 340px;
    object-fit: cover;
    object-position: center top;
    display: block;
}

.trk-search-wrap {
    background: linear-gradient(135deg, #1a0533 0%, #2c1044 60%, #3d1a62 100%);
    padding: 36px 0;
}
.trk-search-inner {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 20px;
    text-align: center;
}
.trk-search-inner h2 {
    color: #fff;
    font-size: 22px;
    margin: 0 0 6px;
}
.trk-search-inner p {
    color: rgba(255,255,255,0.65);
    font-size: 13px;
    margin: 0 0 20px;
}
.trk-bar {
    display: flex;
    gap: 10px;
    max-width: 560px;
    margin: 0 auto;
}
.trk-bar input {
    flex: 1;
    padding: 14px 18px;
    border: none;
    border-radius: 6px;
    font-size: 14px;
    outline: none;
    letter-spacing: 1px;
}
.trk-bar button {
    background: var(--primary-yellow, #f5c518);
    color: #111;
    font-weight: 800;
    border: none;
    padding: 0 28px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 14px;
    white-space: nowrap;
    transition: background 0.2s;
}
.trk-bar button:hover { background: #e0b010; }

/* ── ERROR STATE ── */
.trk-error {
    background: #fff0f0;
    border: 1px solid #fca5a5;
    border-radius: 8px;
    padding: 20px 24px;
    margin: 30px auto;
    max-width: 680px;
    display: flex;
    align-items: center;
    gap: 14px;
    color: #991b1b;
    font-size: 14px;
    font-weight: 600;
}
.trk-error svg { flex-shrink: 0; }

/* ── RESULT CARD ── */
.trk-result {
    max-width: 760px;
    margin: 36px auto 60px;
    padding: 0 20px;
}
.trk-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 4px 30px rgba(0,0,0,0.10);
    overflow: hidden;
}
.trk-card-header {
    background: linear-gradient(135deg, #1a0533, #3d1a62);
    padding: 22px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
}
.trk-card-header h3 {
    color: #fff;
    margin: 0;
    font-size: 18px;
}
.trk-card-header .trk-id {
    background: var(--primary-yellow, #f5c518);
    color: #111;
    padding: 5px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
}
.trk-meta {
    padding: 20px 28px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
    border-bottom: 1px solid #f1f5f9;
    background: #fafafa;
}
.trk-meta-item label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    color: #94a3b8;
    font-weight: 700;
    margin-bottom: 4px;
}
.trk-meta-item span {
    font-size: 14px;
    color: #0f172a;
    font-weight: 600;
}

/* ── TIMELINE ── */
.trk-timeline {
    padding: 30px 28px;
}
.trk-timeline h4 {
    font-size: 14px;
    font-weight: 700;
    color: #334155;
    margin: 0 0 24px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.tl-steps {
    position: relative;
    padding-left: 36px;
}
.tl-steps::before {
    content: '';
    position: absolute;
    left: 13px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: #e2e8f0;
}
.tl-step {
    position: relative;
    margin-bottom: 28px;
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.tl-step:last-child { margin-bottom: 0; }
.tl-dot {
    position: absolute;
    left: -36px;
    top: 2px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid #e2e8f0;
    background: #fff;
    z-index: 1;
    transition: all 0.3s;
}
.tl-dot.done {
    border-color: #22c55e;
    background: #22c55e;
}
.tl-dot.active {
    border-color: var(--primary-purple, #66329c);
    background: var(--primary-purple, #66329c);
    box-shadow: 0 0 0 4px rgba(102,50,156,0.2);
}
.tl-dot.pending {
    border-color: #cbd5e1;
    background: #f8fafc;
}
.tl-label {
    font-weight: 700;
    font-size: 14px;
    color: #0f172a;
}
.tl-label.dim { color: #94a3b8; }
.tl-sublabel {
    font-size: 12px;
    color: #64748b;
}
.tl-location {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    background: #f1f5f9;
    border-radius: 20px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
    color: #475569;
    margin-top: 4px;
    width: fit-content;
}

/* ── STATUS BADGE ── */
.trk-status-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
.trk-status-badge.preparing { background: #fef3c7; color: #92400e; }
.trk-status-badge.in-transit { background: #dbeafe; color: #1e40af; }
.trk-status-badge.out-for-delivery { background: #ede9fe; color: #5b21b6; }
.trk-status-badge.delivered { background: #dcfce7; color: #15803d; }

/* ── TRUST BAR ── */
.trk-trust {
    background: #f8fafc;
    padding: 40px 20px;
    border-top: 1px solid #e2e8f0;
    margin-top: 40px;
}
.trk-trust-inner {
    max-width: 800px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    text-align: center;
}
.trk-trust-item img {
    max-width: 100%;
    height: auto;
    display: inline-block;
}

@media (max-width: 600px) {
    .trk-bar { flex-direction: column; }
    .trk-trust-inner { grid-template-columns: 1fr; }
    .trk-meta { grid-template-columns: 1fr; }
    .trk-card-header { flex-direction: column; align-items: flex-start; }
}
</style>

<!-- HERO BANNER -->
<div class="trk-hero">
    <img class="trk-hero-img" src="/images/tracking-banner.png" alt="Fast & Secure Delivery — TorMart">
</div>

<!-- SEARCH BAR -->
<div class="trk-search-wrap">
    <div class="trk-search-inner">
        <h2>Track Your Order</h2>
        <p>Enter the tracking ID provided by your vendor to see the live status of your delivery.</p>
        <form action="/track-order" method="POST" class="trk-bar">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="text" name="tracking_id" placeholder="e.g. TRK-4A2F8E1B" value="<%= typeof order !== 'undefined' && order ? order.tracking_id : '' %>" autocomplete="off">
            <button type="submit">Track Order &rarr;</button>
        </form>
    </div>
</div>

<div style="max-width:800px; margin: 0 auto; padding: 0 20px;">
<% if (typeof error !== 'undefined' && error) { %>
<div class="trk-error">
    <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="10" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="M12 8v4m0 4h.01"/></svg>
    <%= error %>
</div>
<% } %>
</div>

<% if (typeof order !== 'undefined' && order) { 
    const statusMap = { 'Preparing': 0, 'In Transit': 1, 'Out for Delivery': 2, 'Delivered': 3 };
    const currentStep = statusMap[order.tracking_status] !== undefined ? statusMap[order.tracking_status] : 1;
    const steps = [
        { label: 'Order Placed', sublabel: 'Your order has been confirmed', icon: '📦' },
        { label: 'In Transit', sublabel: order.item_location ? 'Current location: ' + order.item_location : 'Package is on the way', icon: '🚚' },
        { label: 'Out for Delivery', sublabel: 'Package is out for final delivery', icon: '🏃' },
        { label: 'Delivered', sublabel: 'Package has been delivered successfully', icon: '✅' },
    ];
    const statusClass = { 'Preparing': 'preparing', 'In Transit': 'in-transit', 'Out for Delivery': 'out-for-delivery', 'Delivered': 'delivered' };
%>
<div class="trk-result">
    <div class="trk-card">
        <div class="trk-card-header">
            <div>
                <div style="color:rgba(255,255,255,0.6); font-size:11px; text-transform:uppercase; letter-spacing:1px; margin-bottom:4px;">Order Status</div>
                <h3><%= order.product_name %></h3>
            </div>
            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
                <span class="trk-id"><%= order.tracking_id %></span>
                <span class="trk-status-badge <%= statusClass[order.tracking_status] || 'in-transit' %>"><%= order.tracking_status || 'In Transit' %></span>
            </div>
        </div>

        <div class="trk-meta">
            <div class="trk-meta-item">
                <label>Product</label>
                <span><%= order.product_name %></span>
            </div>
            <div class="trk-meta-item">
                <label>Order ID</label>
                <span>#<%= order.id %></span>
            </div>
            <div class="trk-meta-item">
                <label>Delivery Type</label>
                <span><%= order.delivery_type || 'Physical' %></span>
            </div>
            <div class="trk-meta-item">
                <label>Vendor</label>
                <span><%= order.vendor_display_name || order.vendor_name %></span>
            </div>
            <div class="trk-meta-item">
                <label>Order Date</label>
                <span><%= new Date(order.created_at).toLocaleDateString('en-GB', { day:'numeric', month:'short', year:'numeric' }) %></span>
            </div>
            <div class="trk-meta-item">
                <label>Current Location</label>
                <span><%= order.item_location || '—' %></span>
            </div>
        </div>

        <div class="trk-timeline">
            <h4>📍 Delivery Timeline</h4>
            <div class="tl-steps">
                <% steps.forEach((step, i) => { 
                    const isDone = i < currentStep;
                    const isActive = i === currentStep;
                    const isPending = i > currentStep;
                %>
                <div class="tl-step">
                    <div class="tl-dot <%= isDone ? 'done' : (isActive ? 'active' : 'pending') %>">
                        <% if (isDone) { %>
                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="#fff" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                        <% } else if (isActive) { %>
                        <div style="width:8px;height:8px;border-radius:50%;background:#fff;"></div>
                        <% } %>
                    </div>
                    <div class="tl-label <%= isPending ? 'dim' : '' %>"><%= step.icon %> <%= step.label %></div>
                    <div class="tl-sublabel"><%= step.sublabel %></div>
                    <% if (isActive && order.item_location) { %>
                    <div class="tl-location">
                        <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
                        <%= order.item_location %>
                    </div>
                    <% } %>
                </div>
                <% }) %>
            </div>
        </div>
    </div>

    <div style="text-align:center; margin-top:20px; font-size:13px; color:#64748b;">
        Need help? <a href="/support" style="color:var(--primary-purple, #66329c); font-weight:600;">Contact Support</a> or <a href="/escrow" style="color:var(--primary-purple, #66329c); font-weight:600;">Learn about Escrow</a>
    </div>
</div>

<% } %>

<!-- TRUST BAR -->
<div class="trk-trust">
    <div class="trk-trust-inner">
        <div class="trk-trust-item">
            <img src="/images/icon-shield-3d.png" alt="100% Escrow Protected">
        </div>
        <div class="trk-trust-item">
            <img src="/images/icon-truck-3d.png" alt="Live Order Tracking">
        </div>
        <div class="trk-trust-item">
            <img src="/images/icon-clock-3d.png" alt="24/7 Dispute Resolution">
        </div>
    </div>
</div>

<%- include('footer') %>
