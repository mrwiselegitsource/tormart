<%- include('header') %>

<div class="container" style="max-width: 900px; margin: 40px auto; font-family: 'Inter', sans-serif;">
    <div style="background: linear-gradient(135deg, #1e293b, #0f172a); border-radius: 12px; padding: 60px 40px; text-align: center; color: white; margin-bottom: 40px; box-shadow: 0 10px 25px rgba(0,0,0,0.2);">
        <h1 style="font-size: 3rem; margin-bottom: 20px; font-weight: 800; letter-spacing: -1px;">Become a Tormart Partner</h1>
        <p style="font-size: 1.2rem; color: #cbd5e1; max-width: 600px; margin: 0 auto; line-height: 1.6;">Join our exclusive network of trusted vendors. Reach thousands of active buyers and grow your business in a secure, escrow-protected marketplace.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; margin-bottom: 40px;">
        <div style="background: white; border-radius: 8px; padding: 30px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); text-align: center;">
            <div style="font-size: 40px; margin-bottom: 15px;">🛍️</div>
            <h3 style="font-size: 1.2rem; color: #0f172a; margin-bottom: 10px;">Reach Customers</h3>
            <p style="color: #64748b; line-height: 1.5; font-size: 0.95rem;">Tap into our established community of buyers actively looking for high-quality digital and physical products.</p>
        </div>
        <div style="background: white; border-radius: 8px; padding: 30px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); text-align: center;">
            <div style="font-size: 40px; margin-bottom: 15px;">🛡️</div>
            <h3 style="font-size: 1.2rem; color: #0f172a; margin-bottom: 10px;">Escrow Protection</h3>
            <p style="color: #64748b; line-height: 1.5; font-size: 0.95rem;">Our secure escrow system ensures you get paid for every successful delivery, completely risk-free.</p>
        </div>
        <div style="background: white; border-radius: 8px; padding: 30px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); text-align: center;">
            <div style="font-size: 40px; margin-bottom: 15px;">📊</div>
            <h3 style="font-size: 1.2rem; color: #0f172a; margin-bottom: 10px;">Vendor Dashboard</h3>
            <p style="color: #64748b; line-height: 1.5; font-size: 0.95rem;">Get access to a powerful suite of tools to manage your products, track orders, and communicate with buyers.</p>
        </div>
    </div>

    <div style="background: white; border-radius: 8px; padding: 40px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); margin-bottom: 40px;">
        <h2 style="font-size: 1.8rem; color: #0f172a; margin-bottom: 20px; border-bottom: 2px solid #f1f5f9; padding-bottom: 10px;">Application Process</h2>
        <ol style="color: #475569; font-size: 1.1rem; line-height: 1.8; padding-left: 20px;">
            <li style="margin-bottom: 10px;"><strong>Submit Your Details:</strong> Tell us about your shop, the kind of products you sell, and your delivery policies.</li>
            <li style="margin-bottom: 10px;"><strong>Pay the Registration Fee:</strong> A one-time fee is required to ensure a high-quality marketplace and filter out spam.</li>
            <li style="margin-bottom: 10px;"><strong>Admin Review:</strong> Our team will review your application and payment proof (usually takes less than 24 hours).</li>
            <li style="margin-bottom: 10px;"><strong>Start Selling:</strong> Once approved, you instantly gain access to the Vendor Dashboard!</li>
        </ol>
        
        <div style="text-align: center; margin-top: 40px;">
            <a href="/apply-vendor/step-1" style="display: inline-block; background: #28a745; color: white; font-size: 1.2rem; font-weight: bold; padding: 15px 40px; border-radius: 30px; text-decoration: none; box-shadow: 0 4px 15px rgba(40,167,69,0.3); transition: transform 0.2s;">
                Start Registration Now ➔
            </a>
        </div>
    </div>
</div>

<%- include('footer') %>
