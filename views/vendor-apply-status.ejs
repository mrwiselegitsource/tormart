<%- include('header') %>

<div class="container" style="max-width: 700px; margin: 40px auto; font-family: 'Inter', sans-serif;">
    <div class="form-panel" style="padding: 40px; text-align: center;">
        
        <div style="width: 80px; height: 80px; background: #e0f2fe; color: #0284c7; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 40px; margin: 0 auto 25px;">
            ⏳
        </div>
        
        <h2 style="color: #0f172a; margin-bottom: 15px; font-size: 1.8rem; font-weight: 700;">Application Under Review</h2>
        
        <p style="color: #475569; font-size: 1.1rem; line-height: 1.6; margin-bottom: 30px;">
            Thank you for applying to become a vendor, <strong><%= user.vendor_name %></strong>. Your application and payment verification are currently being reviewed by our administration team.
        </p>

        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 25px; text-align: left; margin-bottom: 30px;">
            <h4 style="margin-top: 0; color: #1e293b; margin-bottom: 15px; font-size: 1.1rem;">Application Details</h4>
            
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
                    <span style="color: #64748b; font-weight: 500;">Status</span>
                    <span style="background: #fef08a; color: #854d0e; padding: 2px 10px; border-radius: 12px; font-size: 0.85rem; font-weight: 700;">PENDING</span>
                </div>
                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding-bottom: 8px;">
                    <span style="color: #64748b; font-weight: 500;">Assigned Crypto Address</span>
                    <span style="color: #0f172a; font-family: monospace; font-size: 0.9rem;"><%= user.application_crypto_address || 'Admin verified' %></span>
                </div>
                <div style="display: flex; justify-content: space-between;">
                    <span style="color: #64748b; font-weight: 500;">Transaction ID (TXID)</span>
                    <span style="color: #0f172a; font-family: monospace; font-size: 0.9rem; word-break: break-all; text-align: right; max-width: 60%;"><%= user.application_txid %></span>
                </div>
            </div>
        </div>
        
        <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 25px;">
            Reviews typically take 1-12 hours. Once approved, you will have immediate access to your Vendor Dashboard.
        </p>

        <a href="/profile" style="display: inline-block; background: #0f172a; color: white; padding: 12px 30px; border-radius: 6px; text-decoration: none; font-weight: 600; font-size: 1rem; transition: background 0.2s;">
            Return to Profile
        </a>
    </div>
</div>

<%- include('footer') %>
