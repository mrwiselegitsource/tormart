<%- include('header') %>

<div class="container" style="max-width: 700px; margin: 40px auto;">
    
    <div style="text-align: center; margin-bottom: 30px;">
        <h2 style="color: #111; margin-bottom: 10px;">Step 1: Shop Details</h2>
        <p style="color: #666;">Tell us about what you plan to sell and your business policies.</p>
        
        <div style="display: flex; justify-content: center; align-items: center; margin-top: 20px;">
            <div style="background: #28a745; color: white; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">1</div>
            <div style="width: 50px; height: 3px; background: #e2e8f0; margin: 0 10px;"></div>
            <div style="background: #e2e8f0; color: #64748b; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold;">2</div>
        </div>
    </div>

    <div class="form-panel" style="padding: 30px;">
        <form action="/apply-vendor/step-1" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            
            <div class="form-group" style="margin-bottom: 20px;">
                <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #333;">Your Proposed Shop Name</label>
                <input type="text" name="vendor_name" class="form-control" placeholder="e.g. Elite Digital Goods" required style="width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;">
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #333;">What kind of products will you be selling?</label>
                <p style="font-size: 13px; color: #666; margin-top: 0; margin-bottom: 8px;">Please be specific (e.g., Physical electronics, cloned cards, digital accounts).</p>
                <textarea name="vendor_short_description" class="form-control" rows="3" placeholder="A brief description of your products..." required style="width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;"></textarea>
            </div>
            
            <div class="form-group" style="margin-bottom: 20px;">
                <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #333;">Delivery Statements & Policies</label>
                <p style="font-size: 13px; color: #666; margin-top: 0; margin-bottom: 8px;">Explain your shipping methods, delivery timeframes, and refund/replacement policies. Buyers and admins will see this.</p>
                <textarea name="vendor_delivery_statement" class="form-control" rows="4" placeholder="e.g. We ship physical items within 24hrs via FedEx. Digital items are sent instantly..." required style="width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;"></textarea>
            </div>

            <div class="form-group" style="margin-bottom: 30px;">
                <label style="display: block; font-weight: 600; margin-bottom: 8px; color: #333;">Contact Info (Telegram / Jabber / Email)</label>
                <p style="font-size: 13px; color: #666; margin-top: 0; margin-bottom: 8px;">How can the admin reach you if there are questions about your application?</p>
                <input type="text" name="application_contact" class="form-control" placeholder="@YourTelegramHandle" required style="width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;">
            </div>

            <button type="submit" class="btn" style="width: 100%; background: var(--primary-color); color: white; border: none; padding: 15px; font-weight: bold; border-radius: 4px; font-size: 16px; cursor: pointer;">
                Continue to Payment ➔
            </button>
        </form>
    </div>
</div>

<%- include('footer') %>
