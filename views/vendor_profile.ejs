<%- include('header') %>

<div style="background: #111; color: white; padding: 40px 20px; text-align: center; position: relative; border-bottom: 4px solid var(--primary-purple);">
    <% if (vendor.vendor_banner) { %>
        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0.3; background-image: url('<%= vendor.vendor_banner %>'); background-size: cover; background-position: center; z-index: 1;"></div>
    <% } %>
    
    <div class="container" style="position: relative; z-index: 2; display: flex; align-items: center; justify-content: center; gap: 20px;">
        <div style="width: 100px; height: 100px; border-radius: 50%; background: #fff; border: 3px solid var(--primary-purple); overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 40px; color: #999;">
            <% if (vendor.vendor_logo) { %>
                <img src="<%= vendor.vendor_logo %>" alt="Logo" style="width: 100%; height: 100%; object-fit: cover;">
            <% } else { %>
                👤
            <% } %>
        </div>
        <div style="text-align: left;">
            <h1 style="margin: 0 0 5px 0; font-size: 28px;"><%= vendor.vendor_name %></h1>
            <div style="color: #28a745; font-weight: bold; font-size: 14px; margin-bottom: 5px;">✓ Trusted Escrow Vendor</div>
            <div style="font-size: 13px; color: #aaa;">Member since <%= new Date(vendor.created_at).getFullYear() %></div>
        </div>
    </div>
</div>

<div class="container" style="max-width: 1100px; margin-top: 30px; margin-bottom: 50px; display: flex; gap: 30px; align-items: flex-start;">
    
    <!-- Left Sidebar -->
    <div style="width: 250px; flex-shrink: 0;">
        <div class="form-panel" style="margin-top: 0;">
            <h4 style="margin-top: 0; border-bottom: 1px solid #eee; padding-bottom: 10px; color: #333;">About Vendor</h4>
            <p style="font-size: 13px; color: #555; line-height: 1.5; margin-bottom: 20px;">
                <%= vendor.vendor_description || 'No description provided.' %>
            </p>
            
            <h4 style="border-bottom: 1px solid #eee; padding-bottom: 10px; color: #333;">Vendor Stats</h4>
            <ul style="list-style: none; padding: 0; margin: 0; font-size: 13px; color: #444;">
                <li style="margin-bottom: 8px; display: flex; justify-content: space-between;"><span>Rating:</span> <strong>5.0 ★</strong></li>
                <li style="margin-bottom: 8px; display: flex; justify-content: space-between;"><span>Reviews:</span> <strong><%= reviews.length %></strong></li>
                <li style="margin-bottom: 8px; display: flex; justify-content: space-between;"><span>Escrow:</span> <strong style="color:#28a745;">Required</strong></li>
                <li style="margin-bottom: 8px; display: flex; justify-content: space-between;"><span>Status:</span> <strong style="color:#28a745;">Online</strong></li>
            </ul>
        </div>
    </div>
    
    <!-- Right Main Area -->
    <div style="flex-grow: 1;">
        <h3 style="margin-top: 0; color: #111; margin-bottom: 20px;">Store Products (<%= products.length %>)</h3>
        
        <% if (products.length === 0) { %>
            <div class="form-panel" style="text-align: center; color: #888; padding: 40px;">
                This vendor currently has no products listed.
            </div>
        <% } else { %>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 20px; margin-bottom: 40px;">
                <% products.forEach(product => { %>
                    <a href="/checkout/<%= product.id %>" class="product-card" style="text-decoration: none; display: block;">
                        <div class="product-image">
                            <img src="<%= product.image %>" alt="<%= product.name %>">
                            <% if (product.tier) { %>
                                <span class="product-tier tier-<%= product.tier.toLowerCase() %>"><%= product.tier %></span>
                            <% } %>
                        </div>
                        <div class="product-info">
                            <h3 class="product-title"><%= product.name %></h3>
                            <p class="product-desc"><%= product.description.length > 50 ? product.description.substring(0, 50) + '...' : product.description %></p>
                            <div class="product-price">$<%= product.price.toFixed(2) %></div>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% } %>

        <h3 style="color: #111; margin-bottom: 20px; margin-top: 40px;">Recent Reviews</h3>
        <% if (reviews.length === 0) { %>
            <div class="form-panel" style="text-align: center; color: #888; padding: 40px;">
                No reviews yet.
            </div>
        <% } else { %>
            <div style="display: flex; flex-direction: column; gap: 15px;">
                <% reviews.forEach(review => { %>
                    <div class="form-panel" style="margin: 0; padding: 15px;">
                        <div style="display: flex; justify-content: space-between; margin-bottom: 10px;">
                            <strong style="color: #333;"><%= review.buyer_name.substring(0,2) %>*** (Verified Buyer)</strong>
                            <span style="color: #f39c12; font-weight: bold;">
                                <% for(let i=0; i<review.rating; i++) { %>★<% } %>
                                <% for(let i=review.rating; i<5; i++) { %>☆<% } %>
                            </span>
                        </div>
                        <p style="margin: 0; font-size: 13px; color: #555;"><%= review.comment %></p>
                        <div style="font-size: 11px; color: #999; margin-top: 10px; text-align: right;"><%= new Date(review.created_at).toLocaleDateString() %></div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>
</div>

<%- include('footer') %>
