<%- include('header') %>

<div class="container" style="max-width: 1000px; margin-top: 30px; margin-bottom: 50px;">
    <h2 style="color: #111; margin-bottom: 20px;"><%= categoryName %></h2>

    <% if (vendors.length === 0) { %>
        <div class="form-panel" style="text-align: center; padding: 40px; color: #666;">
            <p>No verified vendors found in this category right now.</p>
        </div>
    <% } else { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
            <% vendors.forEach(vendor => { %>
                <div class="form-panel" style="margin: 0; display: flex; flex-direction: column; align-items: center; text-align: center;">
                    <div style="width: 80px; height: 80px; border-radius: 50%; background: #eee; margin-bottom: 15px; overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 30px; color: #999;">
                        <% if (vendor.vendor_logo) { %>
                            <img src="<%= vendor.vendor_logo %>" alt="Logo" style="width: 100%; height: 100%; object-fit: cover;">
                        <% } else { %>
                            👤
                        <% } %>
                    </div>
                    
                    <h3 style="margin: 0 0 5px 0; color: #211c3a; font-size: 18px;"><%= vendor.vendor_name %></h3>
                    
                    <div style="font-size: 12px; color: #28a745; font-weight: bold; margin-bottom: 15px;">
                        ✓ Trusted Vendor
                    </div>
                    
                    <p style="font-size: 13px; color: #555; margin-bottom: 20px; line-height: 1.4; flex-grow: 1;">
                        <%= vendor.vendor_description ? (vendor.vendor_description.substring(0, 80) + '...') : 'A verified vendor on TorMart.' %>
                    </p>
                    
                    <div style="display: flex; gap: 15px; margin-bottom: 20px; font-size: 12px; color: #666; background: #f8fafc; padding: 10px; border-radius: 4px; width: 100%; justify-content: center;">
                        <div style="text-align: center;">
                            <strong style="display: block; color: #111; font-size: 14px;">5.0 ★</strong>
                            Rating
                        </div>
                        <div style="border-left: 1px solid #ddd;"></div>
                        <div style="text-align: center;">
                            <strong style="display: block; color: #111; font-size: 14px;">100%</strong>
                            Escrow
                        </div>
                    </div>
                    
                    <a href="/vendor-profile/<%= vendor.id %>" class="btn" style="background: var(--primary-purple); color: white; width: 100%; border-radius: 4px; padding: 10px; font-weight: bold; text-decoration: none;">
                        View Store
                    </a>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<%- include('footer') %>
