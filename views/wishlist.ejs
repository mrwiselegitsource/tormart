<%- include('header') %>

<div class="container" style="max-width: 1100px; margin-top: 30px; margin-bottom: 50px;">
    <!-- Wishlist Header Banner -->
    <div style="background: linear-gradient(135deg, var(--bg-header) 0%, #2c1044 100%); color: #fff; padding: 20px 30px; border-radius: 6px 6px 0 0; border-bottom: 3px solid var(--primary-yellow); box-shadow: 0 2px 5px rgba(0,0,0,0.15); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <div>
            <h1 style="font-size: 22px; font-weight: bold; margin: 0; color: #fff; display: flex; align-items: center; gap: 10px;">
                <span style="color: var(--primary-yellow);">⭐</span> My Wishlist
            </h1>
            <p style="margin: 4px 0 0 0; font-size: 12px; color: #cbd5e1;">Saved items and monitored offers</p>
        </div>
        <div>
            <a href="/" class="btn" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.25); color: #fff; font-size: 12px; padding: 6px 14px; border-radius: 4px;">&larr; Continue Shopping</a>
        </div>
    </div>

    <% 
        const items = (typeof wishlistItems !== 'undefined' && wishlistItems && wishlistItems.length > 0) ? wishlistItems : 
                      ((typeof wishlistIds !== 'undefined' && wishlistIds && wishlistIds.length > 0) ? wishlistIds : []);
    %>

    <% if (!items || items.length === 0) { %>
        <!-- Empty Wishlist State -->
        <div style="background: #fff; padding: 60px 20px; border-radius: 0 0 6px 6px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-align: center;">
            <div style="font-size: 54px; margin-bottom: 15px; color: #94a3b8;">💔</div>
            <h2 style="font-size: 20px; font-weight: bold; color: #1e293b; margin-bottom: 8px;">Your wishlist is empty</h2>
            <p style="color: var(--text-muted); font-size: 14px; max-width: 420px; margin: 0 auto 25px auto;">
                You haven't added any products to your wishlist yet. Explore our verified listings and save your favorite cards and digital assets for quick access.
            </p>
            <a href="/" class="btn btn-purple" style="padding: 12px 30px; font-size: 14px; border-radius: 4px; display: inline-block;">
                Browse Marketplace Products
            </a>
        </div>
    <% } else { %>
        <!-- Wishlist Items Grid -->
        <div style="background: #fff; padding: 30px; border-radius: 0 0 6px 6px; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
                <span style="font-size: 14px; color: var(--text-muted); font-weight: bold;">
                    Saved Products (<%= items.length %>)
                </span>
                <span style="font-size: 12px; color: var(--primary-green); font-weight: bold;">
                    ● Escrow Protection Active
                </span>
            </div>

            <div class="product-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px;">
                <% items.forEach(item => { %>
                    <% 
                        const itemId = (typeof item === 'object' && item !== null && item.id) ? item.id : item;
                        const itemName = (typeof item === 'object' && item !== null && item.name) ? item.name : ('Product #' + itemId);
                        const itemDesc = (typeof item === 'object' && item !== null && item.description) ? item.description : 'High quality marketplace verified asset';
                        const itemCategory = (typeof item === 'object' && item !== null && item.category) ? item.category : 'Carding';
                        const itemImage = (typeof item === 'object' && item !== null && item.image) ? item.image : '/images/cat-carding.jpg';
                        const itemPrice = (typeof item === 'object' && item !== null && typeof item.price === 'number') ? item.price.toFixed(2) : ((typeof item === 'object' && item !== null && item.price) ? item.price : '49.99');
                    %>
                    <div class="product-card" style="border: 1px solid var(--border-color); display: flex; flex-direction: column; justify-content: space-between; height: 100%; border-radius: 6px; overflow: hidden; background: #fff;">
                        <div>
                            <div style="position: relative; height: 160px; background: #1e1b2e; overflow: hidden;">
                                <img src="<%= itemImage %>" alt="<%= itemName %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/images/cat-carding.jpg'">
                                <span style="position: absolute; top: 8px; left: 8px; background: rgba(0,0,0,0.7); color: #fff; font-size: 10px; padding: 3px 8px; border-radius: 3px; font-weight: bold; text-transform: uppercase;">
                                    <%= itemCategory %>
                                </span>
                            </div>
                            
                            <div class="product-details" style="padding: 15px;">
                                <div class="product-title" style="font-size: 15px; font-weight: bold; margin-bottom: 6px; color: #111; height: 38px; overflow: hidden; line-height: 1.3;">
                                    <%= itemName %>
                                </div>
                                <div class="product-desc" style="font-size: 11px; color: var(--text-muted); margin-bottom: 12px; height: 32px; overflow: hidden; line-height: 1.4;">
                                    <%= itemDesc %>
                                </div>
                                
                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border-top: 1px dashed var(--border-color); border-bottom: 1px dashed var(--border-color); margin-bottom: 12px; font-size: 12px;">
                                    <span style="color: var(--text-muted);">Protection:</span>
                                    <span class="text-green" style="font-weight: bold;">Escrow Available</span>
                                </div>

                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                                    <span class="stars" style="font-size: 12px;">★★★★★</span>
                                    <span style="font-size: 18px; font-weight: bold; color: var(--primary-green);">$<%= itemPrice %></span>
                                </div>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div style="padding: 0 15px 15px 15px; display: flex; flex-direction: column; gap: 8px;">
                            <div style="display: flex; gap: 6px;">
                                <a href="/product/<%= itemId %>" class="btn btn-purple" style="flex: 1; padding: 8px; font-size: 12px; text-align: center; border-radius: 4px;">
                                    View
                                </a>
                                <form action="/cart/add" method="POST" style="margin: 0; flex: 1;">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="product_id" value="<%= itemId %>">
                                    <button type="submit" class="btn btn-green" style="width: 100%; padding: 8px; font-size: 12px; border: none; border-radius: 4px; cursor: pointer;">
                                        🛒 Add to Cart
                                    </button>
                                </form>
                            </div>

                            <!-- Remove from Wishlist Form -->
                            <form action="/wishlist/toggle" method="POST" style="margin: 0; width: 100%;">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <input type="hidden" name="product_id" value="<%= itemId %>">
                                <button type="submit" class="btn" style="background: #fff; color: #ef4444; border: 1px solid #fca5a5; width: 100%; padding: 6px; font-size: 11px; border-radius: 4px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 4px; font-weight: bold; transition: background 0.2s;">
                                    <span>✕</span> Remove from Wishlist
                                </button>
                            </form>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } %>
</div>

<%- include('footer') %>
